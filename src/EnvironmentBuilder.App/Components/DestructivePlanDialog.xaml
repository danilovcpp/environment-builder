<Window x:Class="EnvironmentBuilder.App.Components.DestructivePlanDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
 Title="Подтвердить удаление данных" Width="780" Height="660" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.TextPrimary}">
 <Border Background="{DynamicResource Brush.Panel}" Padding="24"><DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><icons:PackIconLucide Kind="TriangleAlert" Width="28" Height="28" Foreground="{DynamicResource Brush.WarningForeground}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
   <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.SectionTitle}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningForeground}" Margin="0,12,0,0" Focusable="True" AutomationProperties.AutomationId="DestructiveWarning"/>
  </StackPanel>
  <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <Button Content="{Binding ConfirmLabel}" Click="Accept" Style="{DynamicResource Button.Destructive}" Margin="0,0,12,8" AutomationProperties.AutomationId="ConfirmDestructiveEdit"/>
   <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="0,0,0,8" AutomationProperties.AutomationId="CancelDestructiveEdit"/>
  </WrapPanel>
  <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Точный план удаления ресурсов и данных" AutomationProperties.AutomationId="DestructivePlanDetails"/>
 </DockPanel></Border>
</Window>
