<Window x:Class="EnvironmentBuilder.App.Components.DestructivePlanDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Подтвердить изменение окружения" Width="780" Height="660" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.TextPrimary}">
 <Border Background="{DynamicResource Brush.Panel}" Padding="24"><DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
   <TextBlock Text="Удалить прежние данные и сохранить новую ревизию" Style="{DynamicResource Text.SectionTitle}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningForeground}" Margin="0,12,0,0" Focusable="True" AutomationProperties.AutomationId="DestructiveWarning"/>
  </StackPanel>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <Button Content="Удалить данные и сохранить" Click="Accept" Style="{DynamicResource Button.Destructive}" Margin="0,0,12,8" AutomationProperties.AutomationId="ConfirmDestructiveEdit"/>
   <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="0,0,0,8" AutomationProperties.AutomationId="CancelDestructiveEdit"/>
  </WrapPanel>
  <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Точный план удаления ресурсов и данных" AutomationProperties.AutomationId="DestructivePlanDetails"/>
 </DockPanel></Border>
</Window>
