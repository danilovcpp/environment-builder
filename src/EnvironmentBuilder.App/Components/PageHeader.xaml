<UserControl x:Class="EnvironmentBuilder.App.Components.PageHeader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" x:Name="Root">
    <Border Background="{DynamicResource Brush.Topbar}" Padding="{DynamicResource Padding.PageHeader}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="{DynamicResource Thickness.DividerBottom}" MinHeight="{DynamicResource Size.Topbar}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ContentPresenter Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Center">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Column" Value="1" />
                        <Setter Property="Margin" Value="{DynamicResource Margin.HeaderActions}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Margin" Value="{DynamicResource Margin.ActionsBelow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers><DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2" /></DataTrigger></Style.Triggers>
                    </Style>
                </DockPanel.Style>
            <icons:PackIconLucide DockPanel.Dock="Left" Kind="{Binding Icon, ElementName=Root}" Width="30" Height="30" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,22,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{DynamicResource Text.PageTitle}" />
                <TextBlock Text="{Binding Description, ElementName=Root}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" ToolTip="{Binding Description, ElementName=Root}" />
            </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
