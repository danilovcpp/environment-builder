<UserControl x:Class="EnvironmentBuilder.App.Components.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" x:Name="Root">
    <Border Background="{DynamicResource Brush.Topbar}" Padding="16,12" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" MinHeight="{DynamicResource Size.Topbar}">
        <DockPanel LastChildFill="True">
            <ContentPresenter DockPanel.Dock="Right" Content="{Binding Actions, ElementName=Root}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <icons:PackIconLucide DockPanel.Dock="Left" Kind="{Binding Icon, ElementName=Root}" Width="32" Height="32" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{DynamicResource Text.PageTitle}" />
            <TextBlock Text="{Binding Description, ElementName=Root}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0" ToolTip="{Binding Description, ElementName=Root}" />
        </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
