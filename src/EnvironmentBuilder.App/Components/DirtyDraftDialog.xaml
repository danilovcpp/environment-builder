<Window x:Class="EnvironmentBuilder.App.Components.DirtyDraftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Несохранённые изменения" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.TextPrimary}">
    <StackPanel Margin="24">
        <TextBlock Text="Сохранить изменения перед выходом?" Style="{DynamicResource Text.SectionTitle}" TextWrapping="Wrap" />
        <TextBlock Text="При выборе «Остаться» введённые данные сохранятся в редакторе." TextWrapping="Wrap" Margin="0,12,0,24" Foreground="{DynamicResource Brush.TextSecondary}" />
        <WrapPanel>
            <Button Content="Сохранить" x:Name="SaveButton" Click="SaveClick" Style="{DynamicResource Button.Primary}" Margin="0,0,8,8" AutomationProperties.AutomationId="DirtySave" />
            <Button Content="Не сохранять" Click="DiscardClick" Margin="0,0,8,8" AutomationProperties.AutomationId="DirtyDiscard" />
            <Button Content="Остаться" IsCancel="True" IsDefault="True" Click="StayClick" Margin="0,0,0,8" AutomationProperties.AutomationId="DirtyStay" />
        </WrapPanel>
    </StackPanel>
</Window>
