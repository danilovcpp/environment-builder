<UserControl x:Class="EnvironmentBuilder.App.Components.ContextPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:authoring="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:packs="clr-namespace:EnvironmentBuilder.App.Features.SeedPacks" xmlns:settings="clr-namespace:EnvironmentBuilder.App.Features.Settings" x:Name="Root">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type authoring:EnvironmentEditorViewModel}">
            <authoring:EnvironmentSummary />
        </DataTemplate>
        <DataTemplate DataType="{x:Type packs:SeedPackLibraryViewModel}">
            <packs:SeedPackDetails />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsDetails />
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="{DynamicResource Size.ContextPanel}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False">
                    <Setter Property="Width" Value="48" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Background="{DynamicResource Brush.Canvas}" Margin="0,6,0,0">
        <Grid Margin="0,0,16,6">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Content="{Binding Detail, ElementName=Root}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Detail, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <Border Style="{DynamicResource Panel.Card}" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Reference.Icon}" />
                                    <TextBlock Text="{Binding Heading, ElementName=Root}" Style="{DynamicResource Text.GroupTitle}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="16">
                                <TextBlock Text="{Binding Text, ElementName=Root}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Focusable="True" AutomationProperties.AutomationId="ContextSummary" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Panel.Card}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <icons:PackIconLucide Kind="CircleCheck" Style="{DynamicResource Reference.Icon}" Foreground="{DynamicResource Brush.SuccessForeground}" />
                                <TextBlock Text="Проверьте перед сохранением" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SupportingText, ElementName=Root}" Style="{DynamicResource Text.Optional}" Focusable="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ToggleButton IsChecked="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}" Style="{DynamicResource Toggle.Context}" AutomationProperties.Name="Свернуть или развернуть контекст" AutomationProperties.AutomationId="ToggleContext" Width="22" Height="22" MinHeight="22" Padding="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0" ToolTip="Свернуть или развернуть панель" Content="‹" />
    </Grid>
</UserControl>
