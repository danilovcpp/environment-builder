<UserControl x:Class="EnvironmentBuilder.App.Components.ContextPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="240" />
            <Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=Root}" Value="False"><Setter Property="Width" Value="48" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border Background="{DynamicResource Brush.ContextPanel}" Padding="16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
        <Expander Header="Контекст" IsExpanded="{Binding IsExpanded, ElementName=Root, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="Свернуть или развернуть контекст">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Text, ElementName=Root}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,12,0,0" /></ScrollViewer>
        </Expander>
    </Border>
</UserControl>
