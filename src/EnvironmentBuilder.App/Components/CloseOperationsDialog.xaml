<Window x:Class="EnvironmentBuilder.App.Components.CloseOperationsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Завершение приложения" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.TextPrimary}">
 <StackPanel Margin="24"><TextBlock Text="{Binding}" TextWrapping="Wrap"/><TextBlock Text="Окно останется открытым до завершения текущего действия, его проверки и записи результата. Отмена не восстанавливает уже изменённые данные." TextWrapping="Wrap" Margin="0,12"/>
  <Button Content="Дождаться и закрыть" Click="Wait" AutomationProperties.AutomationId="WaitAndClose" Margin="0,4"/>
  <Button Content="Безопасно отменить и закрыть" Click="CancelOperations" AutomationProperties.AutomationId="CancelAndClose" Margin="0,4"/>
  <Button x:Name="ReturnButton" Content="Вернуться в приложение" IsCancel="True" AutomationProperties.AutomationId="ReturnFromClose" Margin="0,4"/>
 </StackPanel>
</Window>
