<Window x:Class="EnvironmentBuilder.App.Components.UnknownInitializationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Неоднозначный результат наполнения" Width="720" Height="620" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.TextPrimary}">
 <Border Style="{DynamicResource Panel.Card}" Padding="24"><DockPanel>
  <TextBlock DockPanel.Dock="Top" Text="Решение по результату HTTP-шага" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,12"/>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <CheckBox Content="Я независимо проверил результат в сервисе и подтверждаю его успех" IsChecked="{Binding IndependentlyVerified}" Margin="0,0,0,12" AutomationProperties.AutomationId="IndependentlyVerified"/>
   <WrapPanel>
    <Button Content="Признать проверенный успех" IsEnabled="{Binding IndependentlyVerified}" Click="AcceptVerified" Margin="0,0,8,8"/>
    <Button Content="Повторить с риском дубликатов" Click="Repeat" Style="{DynamicResource Button.Destructive}" Margin="0,0,8,8"/>
    <Button Content="Восстановить baseline…" Click="Refresh" Margin="0,0,8,8"/>
    <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" Margin="0,0,0,8"/>
   </WrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningForeground}" Margin="0,0,0,16"/><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel></ScrollViewer>
 </DockPanel></Border>
</Window>
