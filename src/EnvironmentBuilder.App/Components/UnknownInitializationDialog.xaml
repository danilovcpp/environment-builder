<Window x:Class="EnvironmentBuilder.App.Components.UnknownInitializationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Неоднозначный результат наполнения" Width="720" Height="620" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.TextPrimary}" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
 <Border Style="{DynamicResource Panel.Card}" Padding="{DynamicResource Padding.Dialog}"><DockPanel>
  <TextBlock DockPanel.Dock="Top" Text="Решение по результату HTTP-шага" Style="{DynamicResource Text.SectionTitle}" Margin="{DynamicResource Margin.Field}" />
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <CheckBox Content="Я независимо проверил результат в сервисе и подтверждаю его успех" IsChecked="{Binding IndependentlyVerified}" Margin="{DynamicResource Margin.Field}" AutomationProperties.AutomationId="IndependentlyVerified" />
   <components:SpacedWrapPanel>
    <Button Content="Признать проверенный успех" IsEnabled="{Binding IndependentlyVerified}" Click="AcceptVerified" />
    <Button Content="Повторить с риском дубликатов" Click="Repeat" Style="{DynamicResource Button.Destructive}" />
    <Button Content="Восстановить baseline…" Click="Refresh" />
    <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" />
   </components:SpacedWrapPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningForeground}" Margin="{DynamicResource Margin.Section}" /><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" /></StackPanel></ScrollViewer>
 </DockPanel></Border>
</Window>
