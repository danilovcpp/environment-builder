<UserControl x:Class="EnvironmentBuilder.App.Components.StatusBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <Border Background="{DynamicResource Brush.StatusBar}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,4" Height="{DynamicResource Size.StatusBar}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.SuccessForeground}" Margin="0,0,6,0" />
                <TextBlock Text="Готово" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Text, ElementName=Root}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" ToolTip="{Binding Text, ElementName=Root}" />
        </DockPanel>
    </Border>
</UserControl>
