<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.ComponentEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
        </Style>
    </UserControl.Resources>
    <Border Style="{DynamicResource Panel.Card}" Padding="{DynamicResource Padding.Dense}" Margin="{DynamicResource Margin.Field}">
        <Expander x:Name="SettingsExpander" IsExpanded="{Binding IsExpanded}" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Удалить" Visibility="{Binding CanRemove, Converter={StaticResource Visible}}" VerticalAlignment="Center" Height="28" MinHeight="28" Padding="10,4" FontSize="{DynamicResource FontSize.Small}" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" />
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Text.GroupTitle}" ToolTip="{Binding Id}" />
                        <TextBlock Text="{Binding DefinitionDetails}" Style="{DynamicResource Text.Metadata}" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Expander.Header>
            <TabControl x:Name="ComponentTabs" Margin="0,12,0,0">
                <TabItem Header="Источник">
                    <StackPanel Margin="{DynamicResource Margin.SectionVertical}">
                        <HeaderedContentControl Header="Тип источника" Style="{DynamicResource Form.Field}">
                            <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" AutomationProperties.Name="Тип источника" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Образ (имя, tag или digest)" Style="{DynamicResource Form.Field}" Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                            <TextBox Text="{Binding ImageReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Образ компонента" Tag="source" x:Name="SourceInput" />
                        </HeaderedContentControl>
                        <StackPanel Visibility="{Binding IsBuild, Converter={StaticResource Visible}}">
                            <HeaderedContentControl Header="Папка исходников" Style="{DynamicResource Form.Field}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Выбрать…" Command="{Binding ChooseSourceFolderCommand}" IsEnabled="{Binding CanChooseFolder}" Margin="{DynamicResource Margin.ScrollbarVertical}" />
                                <TextBox x:Name="FolderInput" Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Папка исходников" />
                            </DockPanel>
                            </HeaderedContentControl>
                            <TextBlock Text="{Binding FolderError}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" />
                            <HeaderedContentControl Header="Подкаталог контекста" Style="{DynamicResource Form.Field}">
                                <TextBox Text="{Binding ContextSubdirectory, UpdateSourceTrigger=PropertyChanged}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Dockerfile относительно контекста" Style="{DynamicResource Form.Field}">
                                <TextBox Text="{Binding Dockerfile, UpdateSourceTrigger=PropertyChanged}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Build arguments: JSON map строк" Style="{DynamicResource Form.Field}">
                                <TextBox Text="{Binding BuildArguments, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="{DynamicResource Size.MultilineInput}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Build secrets: JSON map secret:// ссылок" Style="{DynamicResource Form.Field}">
                                <TextBox Text="{Binding BuildSecrets, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="{DynamicResource Size.MultilineInput}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Параметры" Visibility="{Binding HasParameters, Converter={StaticResource Visible}}">
                    <StackPanel Margin="{DynamicResource Margin.SectionVertical}">
                        <TextBlock Text="Отметьте включённые параметры. Секретные значения задаются только ссылкой secret://UUID." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                        <DataGrid ItemsSource="{Binding Parameters}" AutoGenerateColumns="False" Margin="{DynamicResource Margin.Block}" MinHeight="100" Tag="parameters" x:Name="ParametersTable" AutomationProperties.Name="Параметры компонента">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="48" ElementStyle="{StaticResource CheckBox.TableDisplay}" EditingElementStyle="{StaticResource CheckBox.Table}" />
                                <DataGridTextColumn Header="Имя" Binding="{Binding Key}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTextColumn Header="Тип" Binding="{Binding TypeHint}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTextColumn Header="Значение / ссылка" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridCheckBoxColumn Header="Secret ref" Binding="{Binding UseSecret, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource CheckBox.TableDisplay}" EditingElementStyle="{StaticResource CheckBox.Table}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Переменные">
                    <StackPanel Margin="{DynamicResource Margin.SectionVertical}">
                        <StackPanel Visibility="{Binding CanRemove, Converter={StaticResource Visible}}">
                            <TextBlock Text="Имя этого сервиса внутри сети окружения" Style="{DynamicResource Text.Metadata}" />
                            <TextBox Text="{Binding NetworkHost, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,10" />
                        </StackPanel>
                        <Button Content="Добавить переменную" Command="{Binding AddVariableCommand}" HorizontalAlignment="Left" />
                        <DataGrid ItemsSource="{Binding Variables}" AutoGenerateColumns="False" Margin="{DynamicResource Margin.Block}" MinHeight="100" Tag="environment" x:Name="VariablesTable" AutomationProperties.Name="Переменные окружения">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Имя" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTextColumn Header="Значение / ссылка" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridCheckBoxColumn Header="Secret ref" Binding="{Binding UseSecret, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource CheckBox.TableDisplay}" EditingElementStyle="{StaticResource CheckBox.Table}" />
                                <DataGridTemplateColumn Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×" Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.RemoveVariableCommand, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" CommandParameter="{Binding}" AutomationProperties.Name="Удалить переменную" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Порты">
                    <StackPanel Margin="{DynamicResource Margin.SectionVertical}">
                        <TextBlock Text="loopback — только этот компьютер; network — явное открытие выбранного порта для сети. Пустой host port назначается Docker." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                        <Button Content="Добавить порт" Command="{Binding AddPortCommand}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.Block}" />
                        <DataGrid ItemsSource="{Binding Ports}" AutoGenerateColumns="False" MinHeight="100" Tag="ports" x:Name="PortsTable" AutomationProperties.Name="Порты компонента">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="90" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTextColumn Header="Container" Binding="{Binding ContainerPort, UpdateSourceTrigger=PropertyChanged}" Width="75" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTextColumn Header="Host" Binding="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridComboBoxColumn Header="Protocol" ItemsSource="{x:Static local:PortEditor.Protocols}" SelectedItemBinding="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}" Width="75" ElementStyle="{StaticResource Select.TableDisplay}" EditingElementStyle="{StaticResource Select.Table}" />
                                <DataGridComboBoxColumn Header="Доступ" ItemsSource="{x:Static local:PortEditor.AccessScopes}" SelectedItemBinding="{Binding Access, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource Select.TableDisplay}" EditingElementStyle="{StaticResource Select.Table}" />
                                <DataGridComboBoxColumn Header="Назначение" ItemsSource="{x:Static local:PortEditor.Purposes}" SelectedItemBinding="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource Select.TableDisplay}" EditingElementStyle="{StaticResource Select.Table}" />
                                <DataGridTemplateColumn Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×" Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" CommandParameter="{Binding}" AutomationProperties.Name="Удалить порт" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Хранилища">
                    <StackPanel Margin="{DynamicResource Margin.SectionVertical}">
                        <TextBlock Text="managed — отдельный том; readOnlyInput — внешний вход только для чтения. Введите local-path:// ссылку для внешнего входа." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                        <Button Content="Добавить хранилище" Command="{Binding AddStorageCommand}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.Block}" />
                        <DataGrid ItemsSource="{Binding Storage}" AutoGenerateColumns="False" MinHeight="100" Tag="storage" x:Name="StorageTable" AutomationProperties.Name="Хранилища компонента">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridComboBoxColumn Header="Тип" ItemsSource="{x:Static local:StorageEditor.Kinds}" SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="120" ElementStyle="{StaticResource Select.TableDisplay}" EditingElementStyle="{StaticResource Select.Table}" />
                                <DataGridTextColumn Header="Target path" Binding="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTextColumn Header="Path ref" Binding="{Binding PathRef, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                                <DataGridTemplateColumn Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="×" Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.RemoveStorageCommand, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" CommandParameter="{Binding}" AutomationProperties.Name="Удалить хранилище" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=local:ComponentEditor}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Expander>
    </Border>
</UserControl>
