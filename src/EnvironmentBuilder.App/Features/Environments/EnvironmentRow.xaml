<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <StackPanel>
  <Grid Height="{DynamicResource Size.Row}" Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
   <ToggleButton IsChecked="{Binding IsExpanded}" Width="24" Height="28" Style="{DynamicResource Toggle.Row}" AutomationProperties.Name="Развернуть состав окружения"/>
   <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Name}" Margin="0,0,12,0"/>
   <TextBlock Grid.Column="2" Text="{Binding ComponentCount}" VerticalAlignment="Center" Style="{DynamicResource Text.Metadata}"/>
   <Border Grid.Column="3" Style="{DynamicResource Badge.EnvironmentStatus}" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding State}" FontSize="{DynamicResource FontSize.Badge}" ToolTip="{Binding State}"/></Border>
   <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.StartItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Запустить · сначала preflight и проверка входов" AutomationProperties.Name="Запустить окружение"><icons:PackIconLucide Kind="Play"/></Button>
    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.InspectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Исследовать состояние и операции" AutomationProperties.Name="Исследовать окружение" AutomationProperties.AutomationId="InspectEnvironment"><icons:PackIconLucide Kind="Activity"/></Button>
    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Открыть описание" AutomationProperties.Name="Открыть описание" AutomationProperties.AutomationId="OpenEnvironment"><icons:PackIconLucide Kind="FileText"/></Button>
    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.ComposeItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Compose preview" AutomationProperties.Name="Compose preview"><icons:PackIconLucide Kind="Code"/></Button>
   </StackPanel>
  </Grid>
  <Border Margin="12,0,12,12" Style="{DynamicResource Panel.Card}" Padding="12" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
   <StackPanel><TextBlock Text="{Binding Description}" Style="{DynamicResource Text.Optional}" Margin="0,0,0,8"/>
    <DataGrid ItemsSource="{Binding ComponentRows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="340"><DataGrid.Columns>
     <DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Порты" Binding="{Binding Ports}" Width="120"/><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
    </DataGrid.Columns></DataGrid>
    <TextBlock Text="{Binding Measurement}" Style="{DynamicResource Text.Metadata}" Margin="0,8,0,0"/><TextBlock Text="{Binding Id}" Style="{DynamicResource Text.Metadata}" Focusable="True"/><TextBlock Text="{Binding Revision, StringFormat=Ревизия {0}}" Style="{DynamicResource Text.Metadata}"/><TextBlock Text="{Binding SavedAt}" Style="{DynamicResource Text.Metadata}"/><TextBlock Text="{Binding DisabledReason}" Style="{DynamicResource Text.Optional}"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
