<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Height="56" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="{DynamicResource Grid.EnvironmentMetrics}" />
                <ColumnDefinition Width="156" />
            </Grid.ColumnDefinitions>
            <ToggleButton IsChecked="{Binding IsExpanded}" Width="24" Height="28" Style="{DynamicResource Toggle.Row}" AutomationProperties.Name="Развернуть состав окружения" />
            <DockPanel Grid.Column="1" Margin="8,0,12,0">
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding State}">
                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}" /><Style.Triggers><DataTrigger Binding="{Binding StateKey}" Value="unreadable"><Setter Property="Fill" Value="{DynamicResource Brush.ErrorForeground}" /></DataTrigger><DataTrigger Binding="{Binding StateKey}" Value="needsAttention"><Setter Property="Fill" Value="{DynamicResource Brush.WarningForeground}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.GroupTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" Tag="{DynamicResource Preference.ShowDescriptions}" FontSize="{DynamicResource FontSize.Small}" Margin="0,4,0,0" ToolTip="{Binding Description}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Optional}"><Setter Property="TextWrapping" Value="NoWrap" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding TargetIcons}" Margin="8,0" VerticalAlignment="Center" ClipToBounds="True" ToolTip="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.Panel}" CornerRadius="{DynamicResource Radius.Small}" Width="30" Height="30" Margin="0,0,6,0" ToolTip="{Binding Name}">
                            <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{DynamicResource Brush.AccentText}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl Grid.Column="3" ItemsSource="{Binding InfrastructureIcons}" Margin="8,0" VerticalAlignment="Center" ClipToBounds="True" ToolTip="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.Panel}" CornerRadius="{DynamicResource Radius.Small}" Width="30" Height="30" Margin="0,0,6,0" ToolTip="{Binding Name}">
                            <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{DynamicResource Brush.AccentText}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{Binding ComponentCount}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Metadata}" />
                <TextBlock Text="{Binding State}" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,5,0,0" ToolTip="{Binding State}" />
            </StackPanel>
            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="8,0" ClipToBounds="True" Tag="{DynamicResource Layout.Compact}" ToolTip="В разработке: сбор метрик CPU и памяти. Пока данные не получены.">
                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="CPU — · Память —" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" />
                <TextBlock Text="Нет данных" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,5,0,0" />
            </StackPanel>
            <components:SpacedWrapPanel Grid.Column="6" VerticalAlignment="Center">
                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{Binding DataContext.StartItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Запустить окружение" AutomationProperties.Name="Запустить окружение">
                    <icons:PackIconLucide Kind="Play" Width="17" Height="17" />
                </Button>
                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{Binding DataContext.InspectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Исследовать окружение" AutomationProperties.Name="Исследовать окружение" AutomationProperties.AutomationId="InspectEnvironment">
                    <icons:PackIconLucide Kind="Activity" Width="17" Height="17" />
                </Button>
                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Открыть описание" AutomationProperties.Name="Открыть описание" AutomationProperties.AutomationId="OpenEnvironment">
                    <icons:PackIconLucide Kind="Pencil" Width="17" Height="17" />
                </Button>
                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{Binding DataContext.ComposeItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Compose preview" AutomationProperties.Name="Compose preview">
                    <icons:PackIconLucide Kind="FileCode" Width="17" Height="17" />
                </Button>
            </components:SpacedWrapPanel>
        </Grid>
        <Border Margin="16,0,16,12" Style="{DynamicResource Panel.Card}" Padding="0" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Heading}" Background="{DynamicResource Brush.PanelMuted}">
                    <TextBlock Text="Сервисы и инфраструктура" FontWeight="SemiBold" />
                </Border>
                <StackPanel>
                    <DataGrid ItemsSource="{Binding ComponentRows}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="340">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="1*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                            <DataGridTextColumn Header="Образ / Версия" Binding="{Binding Source}" Width="2*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                            <DataGridTextColumn Header="Порты" Binding="{Binding Ports}" Width="1*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                            <DataGridTemplateColumn Header="Ресурсы" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="CPU —     Память —" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander Header="Сведения об описании" Margin="12,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" Style="{DynamicResource Text.Metadata}" />
                            <TextBlock Text="{Binding SavedAt}" Style="{DynamicResource Text.Metadata}" />
                            <TextBlock Text="{Binding DisabledReason}" Style="{DynamicResource Text.Optional}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
