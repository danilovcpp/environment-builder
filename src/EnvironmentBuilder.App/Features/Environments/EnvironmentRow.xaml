<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Panel}" Padding="16">
  <StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="Открыть описание" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="{Binding DisabledReason}" AutomationProperties.AutomationId="OpenEnvironment" Margin="12,0,0,0"/>
    <StackPanel><TextBlock Text="{Binding Name}" Style="{DynamicResource Text.GroupTitle}" ToolTip="{Binding Name}"/><TextBlock Text="{Binding State}" Style="{DynamicResource Text.Metadata}" Margin="0,4,0,0"/></StackPanel>
   </DockPanel>
   <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0"/>
   <Expander Header="Состав и сведения" IsExpanded="{Binding IsExpanded}" Margin="0,8,0,0" AutomationProperties.Name="Развернуть состав окружения">
    <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding Components}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}"/><TextBlock Text="{Binding Revision, StringFormat=Ревизия {0}}"/><TextBlock Text="{Binding SavedAt}"/><TextBlock Text="{Binding Measurement}"/><TextBlock Text="{Binding DisabledReason}" TextWrapping="Wrap"/></StackPanel>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
