<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <StackPanel>
        <Grid Height="56" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="156" />
            </Grid.ColumnDefinitions>
            <ToggleButton IsChecked="{Binding IsExpanded}" Width="24" Height="28" Style="{DynamicResource Toggle.Row}" AutomationProperties.Name="Развернуть состав окружения" />
            <DockPanel Grid.Column="1" Margin="8,0,12,0">
                <Ellipse DockPanel.Dock="Left" Width="12" Height="12" Fill="{DynamicResource Brush.TextDisabled}" Margin="0,0,18,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" Style="{DynamicResource Text.Metadata}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
            <ItemsControl Grid.Column="2" ItemsSource="{Binding TargetIcons}" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.Panel}" CornerRadius="5" Width="30" Height="30" Margin="0,0,6,0" ToolTip="{Binding Name}">
                            <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{Binding Color}" Width="21" Height="21" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl Grid.Column="3" ItemsSource="{Binding InfrastructureIcons}" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{DynamicResource Brush.Panel}" CornerRadius="5" Width="30" Height="30" Margin="0,0,6,0" ToolTip="{Binding Name}">
                            <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{Binding Color}" Width="21" Height="21" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding ComponentCount}" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Text="{Binding State}" Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="0,5,0,0" ToolTip="{Binding State}" />
            </StackPanel>
            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="8,0,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" Style="{DynamicResource Text.Metadata}" FontSize="10" />
                    <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Divider}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="—" Style="{DynamicResource Text.Metadata}" FontSize="10" HorizontalAlignment="Right" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Память" Style="{DynamicResource Text.Metadata}" FontSize="10" />
                    <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource Brush.Divider}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="—" Style="{DynamicResource Text.Metadata}" FontSize="10" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource Reference.OutlineIcon}" Command="{Binding DataContext.StartItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Запустить окружение" AutomationProperties.Name="Запустить окружение">
                    <icons:PackIconLucide Kind="Play" Width="17" Height="17" />
                </Button>
                <Button Style="{DynamicResource Reference.OutlineIcon}" Command="{Binding DataContext.InspectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Исследовать окружение" AutomationProperties.Name="Исследовать окружение" AutomationProperties.AutomationId="InspectEnvironment">
                    <icons:PackIconLucide Kind="Activity" Width="17" Height="17" />
                </Button>
                <Button Style="{DynamicResource Reference.OutlineIcon}" Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Открыть описание" AutomationProperties.Name="Открыть описание" AutomationProperties.AutomationId="OpenEnvironment">
                    <icons:PackIconLucide Kind="Pencil" Width="17" Height="17" />
                </Button>
                <Button Style="{DynamicResource Reference.OutlineIcon}" Command="{Binding DataContext.ComposeItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" IsEnabled="{Binding CanOpen}" ToolTip="Compose preview" AutomationProperties.Name="Compose preview">
                    <icons:PackIconLucide Kind="FileCode" Width="17" Height="17" />
                </Button>
            </StackPanel>
        </Grid>
        <Border Margin="16,0,16,12" Style="{DynamicResource Panel.Card}" Padding="0" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}" Background="{DynamicResource Brush.PanelMuted}">
                    <TextBlock Text="Сервисы и инфраструктура" FontWeight="SemiBold" />
                </Border>
                <StackPanel>
                    <DataGrid ItemsSource="{Binding ComponentRows}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="340">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="1.4*" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="1*" />
                            <DataGridTextColumn Header="Образ / Версия" Binding="{Binding Source}" Width="2*" />
                            <DataGridTextColumn Header="Порты" Binding="{Binding Ports}" Width="1*" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="1*" />
                            <DataGridTemplateColumn Header="Ресурсы" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="CPU —     Память —" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander Header="Сведения об описании" Margin="12,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" Style="{DynamicResource Text.Metadata}" />
                            <TextBlock Text="{Binding SavedAt}" Style="{DynamicResource Text.Metadata}" />
                            <TextBlock Text="{Binding DisabledReason}" Style="{DynamicResource Text.Optional}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
