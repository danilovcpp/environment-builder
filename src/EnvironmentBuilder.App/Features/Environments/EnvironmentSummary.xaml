<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentSummary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource Panel.Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Reference.Icon}" />
                        <TextBlock Text="Сводка конфигурации" Style="{DynamicResource Text.GroupTitle}" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="16">
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Right" Style="{DynamicResource Reference.Badge}" CornerRadius="3" Padding="6,3" Margin="12,0,0,0">
                            <TextBlock FontSize="9">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="ЧЕРНОВИК" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                <Setter Property="Text" Value="СОХРАНЕНО" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" ToolTip="{Binding Name}" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="Box" Foreground="{DynamicResource Brush.IconMuted}" Width="17" Height="17" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ServiceCount}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Сервисов выбрано" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="Database" Foreground="{DynamicResource Brush.IconMuted}" Width="17" Height="17" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding InfrastructureCount}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Инфраструктура" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="Layers" Foreground="{DynamicResource Brush.IconMuted}" Width="17" Height="17" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SeedStatus}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Тестовые данные" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="Network" Foreground="{DynamicResource Brush.IconMuted}" Width="17" Height="17" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PublishedPortCount}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Порты, будет занято" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="HardDrive" Foreground="{DynamicResource Brush.IconMuted}" Width="17" Height="17" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="—" FontSize="12" />
                        <TextBlock Text="Размер образов (оценочно)" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ID окружения" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{DynamicResource Brush.TextTertiary}" Focusable="True" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Brush.SuccessBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,18,0,0">
                        <DockPanel>
                            <icons:PackIconLucide Kind="CircleCheck" Foreground="{DynamicResource Brush.SuccessForeground}" Width="22" Height="22" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding ConfigurationSummary}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.SuccessForeground}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{DynamicResource Panel.Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <icons:PackIconLucide Kind="CircleAlert" Foreground="{DynamicResource Brush.WarningForeground}" Width="20" Height="20" Margin="0,0,14,0" />
                        <TextBlock Text="Проверьте перед сохранением" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="CircleCheck" Foreground="{DynamicResource Brush.SuccessForeground}" Width="18" Height="18" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Errors.Count}" FontSize="11" />
                        <TextBlock Text="Ошибок конфигурации" FontSize="11" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="CircleCheck" Foreground="{DynamicResource Brush.SuccessForeground}" Width="18" Height="18" Margin="0,0,14,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ReadinessIssues.Count}" FontSize="11" />
                        <TextBlock Text="Замечания доступности" FontSize="11" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Margin="0,10">
                        <icons:PackIconLucide Kind="CircleAlert" Foreground="{DynamicResource Brush.WarningForeground}" Width="18" Height="18" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding SeedStatus, StringFormat=Тестовые данные: {0}}" FontSize="11" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding SaveDisabledReason}" Style="{DynamicResource Text.Optional}" Margin="0,16,0,0" FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
