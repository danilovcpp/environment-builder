<Window x:Class="EnvironmentBuilder.App.Features.Environments.InputDeltaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Title="Проверить входы запуска" Width="720" Height="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.TextPrimary}" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
 <Border Background="{DynamicResource Brush.Canvas}" Padding="{DynamicResource Padding.Dialog}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Изменились входы запуска" Style="{DynamicResource Text.SectionTitle}" Margin="{DynamicResource Margin.Field}" /><StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="Отмена завершит preflight до изменения runtime и данных." TextWrapping="Wrap" />
  <components:SpacedWrapPanel Margin="0,12,0,0"><Button Content="Продолжить" Style="{DynamicResource Button.Primary}" Click="Accept" AutomationProperties.AutomationId="AcceptInputDelta" /><Button x:Name="CancelButton" Content="Отмена" IsCancel="True" AutomationProperties.AutomationId="CancelInputDelta" /></components:SpacedWrapPanel>
 </StackPanel><TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="InputDeltaContent" /></DockPanel></Border>
</Window>
