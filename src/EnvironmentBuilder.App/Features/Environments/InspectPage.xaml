<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.InspectPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.TextPrimary}">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.SectionTitle}"/>
   <WrapPanel Margin="0,12"><Button Content="Назад" Command="{Binding ReturnCommand}" AutomationProperties.AutomationId="InspectBack" Margin="0,0,8,0"/>
    <Button Content="Запустить" Command="{Binding StartCommand}" ToolTip="{Binding StartDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="StartEnvironment" Margin="0,0,8,0"/>
    <Button Content="Остановить" Command="{Binding StopCommand}" ToolTip="{Binding StopDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="StopEnvironment" Margin="0,0,8,0"/>
    <Button Content="Отменить дальнейшие этапы" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelOperation" Margin="0,0,8,0"/>
    <Button Content="{x:Static local:EnvironmentCommands.ObservationLabel}" ToolTip="{x:Static local:EnvironmentCommands.ObservationExplanation}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshObservation" Margin="0,0,8,0"/>
    <Button Content="Compose" Command="{Binding ShowComposeCommand}" AutomationProperties.AutomationId="InspectCompose"/>
   </WrapPanel>
   <WrapPanel Margin="0,0,0,8">
    <Button Content="{x:Static local:EnvironmentCommands.ClearLabel}" Command="{Binding ClearDataCommand}" Style="{DynamicResource Button.Destructive}" ToolTip="{x:Static local:EnvironmentCommands.ClearExplanation}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="ClearEnvironmentData" Margin="0,0,8,0"/>
    <Button Content="{x:Static local:EnvironmentCommands.RestoreLabel}" Command="{Binding RestoreBaselineCommand}" Style="{DynamicResource Button.Destructive}" ToolTip="{x:Static local:EnvironmentCommands.RestoreExplanation}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="RestoreEnvironmentBaseline"/>
   </WrapPanel>
   <TextBlock Text="{Binding DataResetDisabledReason}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding RestoreDisabledReason}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <components:OperationProgress/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock Text="{Binding QuiescenceStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/></Grid.RowDefinitions>
   <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.AutomationId="InspectComponents">
    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGrid.RowStyle>
    <DataGrid.Columns><DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Docker" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="120"/><DataGridTextColumn Header="Готовность" Binding="{Binding RuntimeReady}" Width="160"/><DataGridTextColumn Header="Готов к работе" Binding="{Binding ApplicationReady}" Width="160"/><DataGridTextColumn Header="Расхождение" Binding="{Binding Drift}" Width="150"/></DataGrid.Columns>
   </DataGrid>
   <StackPanel Grid.Row="1" Margin="0,12"><TextBlock Text="{Binding Aggregate}" TextWrapping="Wrap"/><TextBlock Text="{Binding Measurements}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding Endpoints}" TextWrapping="Wrap" Margin="0,8"/>
    <CheckBox Content="Приостановить чтение логов" IsChecked="{Binding LogsPaused}"/><TextBlock Text="{Binding LogStatus}" Style="{DynamicResource Text.Metadata}"/>
   </StackPanel>
   <TextBox Grid.Row="2" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.AutomationId="InspectLogs"/>
  </Grid>
 </DockPanel>
</UserControl>
