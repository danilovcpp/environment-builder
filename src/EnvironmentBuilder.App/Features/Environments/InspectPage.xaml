<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.InspectPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments" Background="{DynamicResource Brush.Canvas}" Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="6" Margin="0,0,-10,12">
            <Border Style="{DynamicResource Panel.Card}" Padding="14,12" Margin="0,0,10,0">
                <DockPanel>
                    <icons:PackIconLucide Kind="Box" Foreground="{DynamicResource Brush.Accent}" Width="26" Height="26" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Сервисов" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding RunningSummary}" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="{DynamicResource Brush.Divider}" CornerRadius="3" Height="5" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="14,12" Margin="0,0,10,0">
                <DockPanel>
                    <icons:PackIconLucide Kind="HeartPulse" Foreground="{DynamicResource Brush.Accent}" Width="26" Height="26" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Health" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding HealthSummary}" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="{DynamicResource Brush.Divider}" CornerRadius="3" Height="5" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="14,12" Margin="0,0,10,0">
                <DockPanel>
                    <icons:PackIconLucide Kind="Cpu" Foreground="{DynamicResource Brush.Accent}" Width="26" Height="26" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="CPU" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding CpuSummary}" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="{DynamicResource Brush.Divider}" CornerRadius="3" Height="5" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="14,12" Margin="0,0,10,0">
                <DockPanel>
                    <icons:PackIconLucide Kind="MemoryStick" Foreground="{DynamicResource Brush.Accent}" Width="26" Height="26" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Память" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding MemorySummary}" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="{DynamicResource Brush.Divider}" CornerRadius="3" Height="5" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="14,12" Margin="0,0,10,0">
                <DockPanel>
                    <icons:PackIconLucide Kind="Clock" Foreground="{DynamicResource Brush.Accent}" Width="26" Height="26" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Uptime" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="—" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="{DynamicResource Brush.Divider}" CornerRadius="3" Height="5" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="14,12" Margin="0,0,10,0">
                <DockPanel>
                    <icons:PackIconLucide Kind="Network" Foreground="{DynamicResource Brush.Accent}" Width="26" Height="26" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Открытые порты" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding PortCount}" FontWeight="SemiBold" FontSize="18" />
                        <Border Background="{DynamicResource Brush.Divider}" CornerRadius="3" Height="5" Margin="0,10,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" />
        <Expander DockPanel.Dock="Top" Header="Начальное наполнение: пакеты и результаты шагов" Margin="0,0,0,8">
          <StackPanel>
            <DataGrid ItemsSource="{Binding InitializationSteps}" AutoGenerateColumns="False" IsReadOnly="True" Height="140" EnableRowVirtualization="True">
              <DataGrid.Columns><DataGridTextColumn Header="Экземпляр" Binding="{Binding ComponentId}" Width="*"/><DataGridTextColumn Header="Пакет / версия" Binding="{Binding Pack}" Width="2*"/><DataGridTextColumn Header="Шаг" Binding="{Binding Step}" Width="*"/><DataGridTextColumn Header="Результат" Binding="{Binding State}" Width="*"/><DataGridTextColumn Header="Попытка" Binding="{Binding Attempt}" Width="70"/></DataGrid.Columns>
            </DataGrid>
            <DockPanel Margin="0,8">
                <Button DockPanel.Dock="Right" Content="Решить результат…" Command="{Binding ResolveInitializationCommand}" Margin="8,0" AutomationProperties.AutomationId="ResolveUnknownInitialization"/>
                <ComboBox ItemsSource="{Binding InitializationIssues}" SelectedItem="{Binding SelectedInitializationIssue}" AutomationProperties.Name="Неоднозначный шаг наполнения">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Key.ComponentId}"/><Run Text=" · "/><Run Text="{Binding Key.StepId}"/><Run Text=" · "/><Run Text="{Binding State}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
          </StackPanel>
        </Expander>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{DynamicResource Text.Metadata}" FontSize="10" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static local:EnvironmentCommands.ClearLabel}" Command="{Binding ClearDataCommand}" ToolTip="{Binding DataResetDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="ClearEnvironmentData" Style="{DynamicResource Button.Ghost}" FontSize="11" />
                <Button Content="{x:Static local:EnvironmentCommands.RestoreLabel}" Command="{Binding RestoreBaselineCommand}" ToolTip="{Binding RestoreDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="RestoreEnvironmentBaseline" Style="{DynamicResource Button.Ghost}" FontSize="11" />
                <Button Content="Отменить этапы" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelOperation" Style="{DynamicResource Button.Ghost}" FontSize="11" />
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1.35*" MinHeight="180" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.6*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource Panel.Card}" Padding="0" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Box" Style="{DynamicResource Reference.Icon}" />
                                <TextBlock Text="Сервисы" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="14,8,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{DynamicResource Input.Search}" Tag="Поиск сервисов..." ToolTip="Предварительный просмотр поиска сервисов" />
                            <ComboBox Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Right" Width="130" Margin="10,0">
                                <ComboBoxItem Content="Все" />
                                <ComboBoxItem Content="Запущенные" />
                                <ComboBoxItem Content="Остановленные" />
                            </ComboBox>
                            <Button Grid.Column="2" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshObservation" AutomationProperties.Name="{x:Static local:EnvironmentCommands.ObservationLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="RefreshCw" Width="16" Height="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Обновить" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Components}" SelectedItem="{Binding SelectedComponent}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="InspectComponents" Margin="12,0,12,10">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="ToolTip" Value="{Binding Details}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="30">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="False" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Название" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{DynamicResource Brush.Accent}" Width="20" Height="20" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Тип" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource Reference.Badge}" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding Category}" FontSize="10" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Контейнер" Binding="{Binding Container}" Width="1.3*" />
                                <DataGridTextColumn Header="Порты" Binding="{Binding Ports}" Width="0.7*" />
                                <DataGridTemplateColumn Header="Статус" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayStatus}" FontSize="11" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Health" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource Reference.Badge}" Background="{DynamicResource Brush.NeutralBackground}" TextElement.Foreground="{DynamicResource Brush.NeutralForeground}" CornerRadius="4" Padding="6,3">
                                                <TextBlock Text="{Binding Health}" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CPU / Память" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="— / —" Style="{DynamicResource Text.Metadata}" FontSize="11" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Действия" Width="74">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                                    <icons:PackIconLucide Kind="ExternalLink" Width="15" Height="15" Foreground="{DynamicResource Brush.Accent}" />
                                                </Button>
                                                <Button Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                                    <icons:PackIconLucide Kind="FileText" Width="15" Height="15" Foreground="{DynamicResource Brush.Accent}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource Panel.Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Reference.Icon}" />
                                <TextBlock Text="Сводка окружения" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconLucide Kind="Box" Width="15" Height="15" Foreground="{DynamicResource Brush.IconMuted}" />
                                    <TextBlock Grid.Column="1" Text="Название" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconLucide Kind="Layers" Width="15" Height="15" Foreground="{DynamicResource Brush.IconMuted}" />
                                    <TextBlock Grid.Column="1" Text="Профиль" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="Локальное окружение" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconLucide Kind="Monitor" Width="15" Height="15" Foreground="{DynamicResource Brush.IconMuted}" />
                                    <TextBlock Grid.Column="1" Text="Запуск" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="Локально" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconLucide Kind="Container" Width="15" Height="15" Foreground="{DynamicResource Brush.IconMuted}" />
                                    <TextBlock Grid.Column="1" Text="Docker Engine" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="Не проверен" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconLucide Kind="Network" Width="15" Height="15" Foreground="{DynamicResource Brush.IconMuted}" />
                                    <TextBlock Grid.Column="1" Text="Открытые порты" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    <TextBlock Grid.Column="2" Text="{Binding PortCount}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="{Binding QuiescenceStatus}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" FontSize="11" Margin="0,12,0,8" />
                                <components:OperationProgress />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="0.95*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource Panel.Card}" Padding="0" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Reference.Icon}" />
                                <TextBlock Text="Логи" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TabControl>
                            <TabItem Header="Все">
                                <DockPanel Margin="12,6,12,10">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <CheckBox Content="Приостановить" IsChecked="{Binding LogsPaused}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LogStatus}" Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="12,0,0,0" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Background="#121C2C" Foreground="#C5D7E5" BorderThickness="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Padding="10" AutomationProperties.AutomationId="InspectLogs" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Метрики">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="{Binding Aggregate}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Measurements}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Адреса">
                                <TextBlock Text="{Binding Endpoints}" TextWrapping="Wrap" Margin="12" />
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource Panel.Card}" Padding="0" Margin="0,0,12,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="ChartColumn" Style="{DynamicResource Reference.Icon}" />
                                <TextBlock Text="Метрики и ресурсы" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <icons:PackIconLucide Kind="Cpu" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="CPU (все сервисы)" FontSize="11" />
                                            <TextBlock Text="{Binding CpuSummary}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <icons:PackIconLucide Kind="MemoryStick" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="Память (все сервисы)" FontSize="11" />
                                            <TextBlock Text="{Binding MemorySummary}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <icons:PackIconLucide Kind="Network" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="Сеть (RX / TX)" FontSize="11" />
                                            <TextBlock Text="— / —" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <icons:PackIconLucide Kind="HardDrive" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" Margin="0,0,14,0" />
                                        <StackPanel>
                                            <TextBlock Text="Диск I/O" FontSize="11" />
                                            <TextBlock Text="— / —" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding Aggregate}" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource Panel.Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Link" Style="{DynamicResource Reference.Icon}" />
                                <TextBlock Text="Эндпоинты и доступ" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                    <icons:PackIconLucide Kind="Globe" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" Margin="0,0,12,0" />
                                    <TextBlock Text="Адреса выбранного сервиса" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding Endpoints}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.AccentText}" FontSize="12" Focusable="True" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
