<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.ComposePreviewPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <DockPanel><StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="Вернуться к описанию" Command="{Binding GoBackCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="BackFromPreview"/><Button Content="Копировать preview" Command="{Binding CopyCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap"/><ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" AutomationProperties.Name="Чтение входных файлов"/><Expander Header="Ревизия и доступность входов" IsExpanded="True" Margin="0,4,0,12"><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel>
 <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ComposeContent"/>
 </DockPanel>
</UserControl>
