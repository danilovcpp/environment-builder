<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.ComposePreviewPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}"/>
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" AutomationProperties.Name="Чтение входных файлов"/>
   <Border Style="{DynamicResource Panel.Card}" Margin="0,0,0,12"><Expander Header="Ревизия и доступность входов" IsExpanded="False"><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></Expander></Border>
  </StackPanel>
  <Border Style="{DynamicResource Panel.Card}" Padding="0"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8"><icons:PackIconLucide Kind="Code" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,8,0"/><TextBlock Text="Compose · секреты замаскированы" Style="{DynamicResource Text.GroupTitle}"/></StackPanel>
   <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="{DynamicResource FontSize.Metadata}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0,1,0,0" AutomationProperties.AutomationId="ComposeContent"/>
  </DockPanel></Border>
 </DockPanel>
</UserControl>
