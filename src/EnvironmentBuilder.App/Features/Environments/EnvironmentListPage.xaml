<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" />
            <Button Content="Повторить загрузку" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.Block}" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
            <TextBlock Text="Загрузка окружений…" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding SelectionNotice}" Style="{DynamicResource Text.Optional}" />
            <TextBlock Text="{Binding DeletionDetails}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.WarningForeground}" AutomationProperties.AutomationId="DeletionRemnants" MaxHeight="150" />
            <Button Content="Отменить дальнейшие этапы удаления" Command="{Binding CancelDeleteCommand}" Visibility="{Binding IsDeleting, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.Block}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="{DynamicResource Margin.Footer}">
            <components:SpacedWrapPanel>
                <Button Content="{x:Static local:EnvironmentCommands.ObservationLabel}" Command="{Binding ObserveSelectedCommand}" ToolTip="{x:Static local:EnvironmentCommands.ObservationExplanation}" AutomationProperties.AutomationId="ObserveSelectedEnvironment" Style="{DynamicResource Button.Ghost}" FontSize="{DynamicResource FontSize.Small}" />
                <Button Content="{x:Static local:EnvironmentCommands.ClearLabel}" Command="{Binding ClearSelectedDataCommand}" ToolTip="{x:Static local:EnvironmentCommands.ClearExplanation}" AutomationProperties.AutomationId="ClearSelectedEnvironmentData" Style="{DynamicResource Button.Ghost}" FontSize="{DynamicResource FontSize.Small}" />
                <Button Content="{x:Static local:EnvironmentCommands.RestoreLabel}" Command="{Binding RestoreSelectedBaselineCommand}" ToolTip="{x:Static local:EnvironmentCommands.RestoreExplanation}" AutomationProperties.AutomationId="RestoreSelectedEnvironmentBaseline" Style="{DynamicResource Button.Ghost}" FontSize="{DynamicResource FontSize.Small}" />
                <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteSelectedCommand}" ToolTip="{x:Static local:EnvironmentCommands.DeleteExplanation}" AutomationProperties.AutomationId="DeleteSelectedEnvironment" Style="{DynamicResource Button.Destructive}" FontSize="{DynamicResource FontSize.Small}" />
            </components:SpacedWrapPanel>
            <TextBlock Text="{Binding OfflineStatus}" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" Margin="{DynamicResource Margin.ScrollbarHorizontal}" />
        </StackPanel>
        <Border Style="{DynamicResource Panel.Card}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="14,14">
                    <components:SpacedWrapPanel Spacing="{DynamicResource Spacing.12}">
                        <components:SpacedWrapPanel>
                            <RadioButton Content="Все" IsChecked="{Binding AllStatus}" Style="{DynamicResource Toggle.Chip}" />
                            <RadioButton Content="Не проверено" IsChecked="{Binding UnknownStatus}" Style="{DynamicResource Toggle.Chip}" />
                            <RadioButton Content="Требует сверки" IsChecked="{Binding AttentionStatus}" Style="{DynamicResource Toggle.Chip}" />
                            <RadioButton Content="Ошибка" IsChecked="{Binding ErrorStatus}" Style="{DynamicResource Toggle.Chip}" />
                        </components:SpacedWrapPanel>
                        <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск окружений..." Width="{DynamicResource Size.Search}" AutomationProperties.AutomationId="EnvironmentSearch" AutomationProperties.Name="Поиск по имени и описанию" />
                        <ComboBox Width="{DynamicResource Size.Filter}" ItemsSource="{x:Static local:EnvironmentListViewModel.TypeOptions}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding TypeFilter}" AutomationProperties.Name="Фильтр типа" />
                    </components:SpacedWrapPanel>
                </Border>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Panel}" Height="38" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="156" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" Style="{DynamicResource Text.TableHeader}" />
                        <TextBlock Grid.Column="1" Text="Название" Style="{DynamicResource Text.TableHeader}" />
                        <TextBlock Grid.Column="2" Text="Сервисы" Style="{DynamicResource Text.TableHeader}" />
                        <TextBlock Grid.Column="3" Text="Инфраструктура" Style="{DynamicResource Text.TableHeader}" />
                        <TextBlock Grid.Column="4" Text="Сводка" Style="{DynamicResource Text.TableHeader}" />
                        <TextBlock Grid.Column="5" Text="" Style="{DynamicResource Text.TableHeader}" />
                        <TextBlock Grid.Column="6" Text="Команды" Style="{DynamicResource Text.TableHeader}" />
                    </Grid>
                </Border>
                <Grid>
                    <ListBox x:Name="Rows" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}" AutomationProperties.AutomationId="EnvironmentRows" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.ScrollChanged="RowsScrollChanged" Loaded="RowsLoaded" HorizontalContentAlignment="Stretch" Background="{DynamicResource Brush.Panel}" BorderThickness="0" ItemContainerStyle="{DynamicResource List.TableRow}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel ScrollUnit="Pixel" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:EnvironmentRow />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24">
                        <TextBlock Text="Создайте первое окружение" Style="{DynamicResource Text.SectionTitle}" TextAlignment="Center" />
                        <TextBlock Text="Сначала добавьте свои сервисы и инфраструктуру в настройках. Затем выберите состав окружения, задайте переменные и запустите его." TextWrapping="Wrap" TextAlignment="Center" Margin="{DynamicResource Margin.SectionVertical}" />
                        <components:SpacedWrapPanel HorizontalAlignment="Center">
                            <Button Content="Настроить сервисы" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="settings" />
                            <Button Content="Создать окружение" Command="{Binding CreateNewCommand}" Style="{DynamicResource Button.Primary}" />
                        </components:SpacedWrapPanel>
                    </StackPanel>
                    <TextBlock Text="По заданным фильтрам ничего не найдено." Visibility="{Binding NoResults, Converter={StaticResource Visible}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
