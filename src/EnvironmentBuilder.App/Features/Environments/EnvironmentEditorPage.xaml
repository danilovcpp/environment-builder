<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Loaded="PageLoaded" Unloaded="PageUnloaded" GotKeyboardFocus="RememberFocus">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource Panel.Card}" Padding="12,8" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Compose preview" Command="{Binding ShowPreviewCommand}" Margin="0,0,10,0" Foreground="{DynamicResource Brush.AccentText}" />
                    <Button Content="Сохранить описание" Command="{Binding SaveCommand}" Style="{DynamicResource Button.Primary}" />
                </StackPanel>
                <TextBlock Text="Выберите сервисы и инфраструктуру для создания окружения." Style="{DynamicResource Text.Metadata}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,12,0" />
            </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top">
            <Button Content="Исследовать / запуск" Command="{Binding InspectSavedCommand}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Запуск доступен после сохранения описания." ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="EditorInspect" />
            <Button Content="Изменить окружение" Command="{Binding BeginEditCommand}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Редактирование требует проверенной остановки; сохранение удалит прежние данные после подтверждения." ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="BeginEditEnvironment" />
            <Button Content="Отменить сохранение" Command="{Binding SaveCancelCommand}" Visibility="{Binding SaveCommand.IsRunning, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Новые этапы будут отменены после текущего безопасного шага. Уже удалённые данные не восстанавливаются." ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="CancelEditSave" />
            <TextBlock Style="{DynamicResource Text.Optional}" Text="{Binding SaveDisabledReason}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Focusable="True" AutomationProperties.AutomationId="SaveDisabledReason" />
            <TextBlock Style="{DynamicResource Text.Optional}" Text="{Binding ActionError}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,4" AutomationProperties.Name="Выполняется действие" />
            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Left" Style="{DynamicResource Button.Ghost}" Command="{Binding DataContext.FocusErrorCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.ErrorForeground}">
                                <Run Text="{Binding FieldPath}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ScrollViewer x:Name="EditorScroll" IsEnabled="{Binding CanInteract}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="RememberScroll">
            <StackPanel Width="{Binding ViewportWidth, ElementName=EditorScroll}">
                <Border Style="{DynamicResource Panel.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Label Content="Имя окружения" Target="{Binding ElementName=NameInput}" />
                                <TextBox x:Name="NameInput" Tag="name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" MaxLength="256" AutomationProperties.AutomationId="EnvironmentName" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Неизменяемый ID" />
                                <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="ID окружения" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ConfigurationSummary}" Style="{DynamicResource Text.Metadata}" Margin="0,8,0,8" />
                        <Expander Header="Описание">
                            <TextBox x:Name="DescriptionInput" Tag="description" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxLength="4096" AutomationProperties.Name="Описание окружения" Margin="0,8,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Grid Margin="0,0,0,12" IsEnabled="{Binding CanEdit}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Margin="0,0,6,0" Style="{DynamicResource Panel.Card}" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Box" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,14,0" />
                                    <TextBlock Text="Сервисы и проекты" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Выберите сервисы для включения в окружение. Зависимости добавляются автоматически." Style="{DynamicResource Text.Metadata}" FontSize="11" TextWrapping="Wrap" Margin="40,4,0,16" />
                                <TextBox Style="{DynamicResource Input.Search}" Tag="Поиск сервисов..." Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск сервисов" Margin="0,0,0,12" />
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="1" Text="Название" Style="{DynamicResource Reference.TableHeader}" />
                                    <TextBlock Grid.Column="2" Text="Версия / Образ" Style="{DynamicResource Reference.TableHeader}" />
                                    <TextBlock Grid.Column="3" Text="Тип" Style="{DynamicResource Reference.TableHeader}" />
                                    <TextBlock Grid.Column="4" Text="Действия" Style="{DynamicResource Reference.TableHeader}" />
                                </Grid>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TargetDefinitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid Height="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="False" IsHitTestVisible="False" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <icons:PackIconLucide Kind="Settings" Width="22" Height="22" Foreground="#FF8500" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Definition.Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Label}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
                                                <Border Grid.Column="3" Style="{DynamicResource Reference.Badge}" Padding="5,2" CornerRadius="3" Margin="4,0">
                                                    <TextBlock Text="Backend" FontSize="10" />
                                                </Border>
                                                <Button Grid.Column="4" Content="Добавить" Command="{Binding DataContext.AddDefinitionCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" FontSize="11" Foreground="{DynamicResource Brush.AccentText}" Margin="4,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="6,0,0,0" Style="{DynamicResource Panel.Card}" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Database" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,14,0" />
                                    <TextBlock Text="Инфраструктура" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Выберите инфраструктурные компоненты окружения." Style="{DynamicResource Text.Metadata}" FontSize="11" TextWrapping="Wrap" Margin="40,4,0,16" />
                                <TextBox Style="{DynamicResource Input.Search}" Tag="Поиск компонентов..." Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск инфраструктуры" Margin="0,0,0,12" />
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="False" IsHitTestVisible="False" />
                                    <TextBlock Grid.Column="1" Text="Название" Style="{DynamicResource Reference.TableHeader}" />
                                    <TextBlock Grid.Column="2" Text="Версия / Образ" Style="{DynamicResource Reference.TableHeader}" />
                                    <TextBlock Grid.Column="3" Text="Тип" Style="{DynamicResource Reference.TableHeader}" />
                                    <TextBlock Grid.Column="4" Text="Действия" Style="{DynamicResource Reference.TableHeader}" />
                                </Grid>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding InfrastructureDefinitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid Height="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="0.8*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="False" IsHitTestVisible="False" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <icons:PackIconLucide Kind="Database" Width="22" Height="22" Foreground="#1B659A" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Definition.Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding Label}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
                                                <Border Grid.Column="3" Style="{DynamicResource Reference.Badge}" Padding="5,2" CornerRadius="3" Margin="4,0">
                                                    <TextBlock Text="Infrastructure" FontSize="10" />
                                                </Border>
                                                <Button Grid.Column="4" Content="Добавить" Command="{Binding DataContext.AddDefinitionCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" FontSize="11" Foreground="{DynamicResource Brush.AccentText}" Margin="4,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
                <Expander IsExpanded="True" Header="Импорт и выбор компонента" Margin="0,0,0,12">
                    <StackPanel IsEnabled="{Binding CanEdit}" Margin="12">
                        <TextBlock Text="{Binding LibraryStatus}" Style="{DynamicResource Text.Metadata}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedDefinition}" DisplayMemberPath="Label" Width="280" Margin="0,0,8,8" AutomationProperties.AutomationId="ComponentLibrary" />
                            <Button Content="Добавить компонент" Command="{Binding AddComponentCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="AddComponent" />
                            <Button Content="Импорт описания…" Command="{Binding ImportComponentCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Выбранный состав · настройки экземпляров" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Components}" Tag="components">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ComponentEditor />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <Expander Header="Зависимости экземпляров" IsExpanded="False" Margin="0,8,0,16" Tag="dependencies">
                        <StackPanel Margin="0,8">
                            <TextBlock Text="Обязательная связь содержит причину включения. При нескольких подходящих экземплярах выберите нужный явно." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                            <ItemsControl ItemsSource="{Binding UnresolvedDependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Requirement.Reason}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" Margin="0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8">
                                <ComboBox ItemsSource="{Binding UnresolvedDependencies}" SelectedItem="{Binding SelectedRequirement}" DisplayMemberPath="Requirement.Id" Width="180" AutomationProperties.Name="Неразрешённое требование" />
                                <ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding SelectedRequiredInstance}" DisplayMemberPath="Label" Width="240" Margin="8,0" AutomationProperties.Name="Выбор экземпляра зависимости" />
                                <Button Content="Назначить" Command="{Binding BindRequirementCommand}" />
                            </WrapPanel>
                            <Button Content="Добавить связь" Command="{Binding AddDependencyCommand}" HorizontalAlignment="Left" />
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8">
                                            <WrapPanel>
                                                <ComboBox ItemsSource="{Binding DataContext.ComponentChoices, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding DependentId}" Width="240" AutomationProperties.Name="Зависимый экземпляр" />
                                                <TextBlock Text=" → " VerticalAlignment="Center" />
                                                <ComboBox ItemsSource="{Binding DataContext.ComponentChoices, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding RequiredId}" Width="240" AutomationProperties.Name="Требуемый экземпляр" />
                                                <ComboBox ItemsSource="{x:Static local:DependencyEditor.Conditions}" SelectedItem="{Binding Condition}" Width="100" Margin="8,0" />
                                                <Button Content="×" Command="{Binding DataContext.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" AutomationProperties.Name="Удалить связь" />
                                            </WrapPanel>
                                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Причина зависимости" Margin="0,4" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Baseline и начальная инициализация" IsExpanded="False" Margin="0,0,0,16" Tag="baseline">
                        <StackPanel Margin="0,8">
                            <TextBlock Text="Применения выполняются по порядку. Для пакета укажите точные ID, version и contentHash; initializer остаётся сохранённым snapshot." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                            <WrapPanel Margin="0,8">
                                <ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding BaselineTarget}" DisplayMemberPath="Label" Width="300" Margin="0,0,8,0" AutomationProperties.Name="Целевой экземпляр baseline" />
                                <Button Content="Добавить initializer…" Command="{Binding AddBaselineCommand}" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Baseline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="12" Margin="0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Выше" IsEnabled="{Binding CanEdit}" Command="{Binding DataContext.MoveBaselineUpCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" Margin="0,0,8,0" />
                                                        <Button Content="Удалить" IsEnabled="{Binding CanEdit}" Command="{Binding DataContext.RemoveBaselineCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <ComboBox ItemsSource="{Binding DataContext.ComponentChoices, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding ComponentId}" IsEnabled="{Binding CanEdit}" Margin="0,8" AutomationProperties.Name="Назначение baseline" />
                                                <StackPanel IsEnabled="{Binding CanEdit}">
                                                    <CheckBox Content="Применить точный SeedPack" IsChecked="{Binding UsePack}" />
                                                    <WrapPanel Margin="0,8">
                                                        <StackPanel Width="290">
                                                            <TextBlock Text="Pack ID" />
                                                            <TextBox Text="{Binding PackId, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Width="130" Margin="8,0">
                                                            <TextBlock Text="Version" />
                                                            <TextBox Text="{Binding PackVersion, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <TextBlock Text="Content hash (SHA-256)" />
                                                    <TextBox Text="{Binding PackHash, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <Expander Header="Initializer snapshot (JSON)" Margin="0,8">
                                                    <TextBox Text="{Binding InitializerJson, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsMandatory}" AcceptsReturn="True" AcceptsTab="False" FontFamily="Consolas" Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Initializer snapshot" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Локальные пути" Margin="0,0,0,16">
                        <StackPanel Margin="0,8">
                            <TextBlock Text="Ссылка переносится с описанием; выбранная папка хранится только на этом компьютере. Выбор ничего не запускает." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                            <WrapPanel Margin="0,8">
                                <TextBox Text="{Binding MappingReference, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,8,0" AutomationProperties.Name="Локальная ссылка" />
                                <Button Content="Выбрать папку…" Command="{Binding ChooseFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Button Content="Проверить доступность входов" Command="{Binding CheckReadinessCommand}" HorizontalAlignment="Left" Margin="0,8" />
                <Expander Header="Полный сохранённый snapshot" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" Margin="0,8">
                    <TextBox Text="{Binding SavedDocumentJson, Mode=OneWay}" IsReadOnly="True" Height="300" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Expander>
                <ItemsControl ItemsSource="{Binding ReadinessIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningForeground}" Margin="0,4">
                                <Run Text="{Binding FieldPath}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Code}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
