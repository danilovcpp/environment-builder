<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" Loaded="PageLoaded" Unloaded="PageUnloaded" GotKeyboardFocus="RememberFocus" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource Panel.Card}" Padding="12,8" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Выберите сервисы и инфраструктуру для создания окружения." Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" Margin="{DynamicResource Margin.ControlBottom}" />
                <components:SpacedWrapPanel HorizontalAlignment="Right">
                    <Button Content="Compose preview" Command="{Binding ShowPreviewCommand}" Foreground="{DynamicResource Brush.AccentText}" />
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveEnvironmentFooter" />
                    <Button Content="Сохранить и запустить" Command="{Binding SaveAndStartCommand}" Style="{DynamicResource Button.Primary}" AutomationProperties.AutomationId="SaveAndStartEnvironment" />
                </components:SpacedWrapPanel>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top">
            <Button Content="Исследовать / запуск" Command="{Binding InspectSavedCommand}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Запуск доступен после сохранения описания." ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="EditorInspect" />
            <Button Content="Изменить окружение" Command="{Binding BeginEditCommand}" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Редактирование требует проверенной остановки; сохранение удалит прежние данные после подтверждения." ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="BeginEditEnvironment" />
            <Button Content="Отменить сохранение" Command="{Binding SaveCancelCommand}" Visibility="{Binding SaveCommand.IsRunning, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Новые этапы будут отменены после текущего безопасного шага. Уже удалённые данные не восстанавливаются." ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="CancelEditSave" />
            <TextBlock Style="{DynamicResource Text.Optional}" Text="{Binding SaveDisabledReason}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Focusable="True" AutomationProperties.AutomationId="SaveDisabledReason" />
            <TextBlock Style="{DynamicResource Text.Optional}" Text="{Binding ActionError}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,4" AutomationProperties.Name="Выполняется действие" />
            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,4,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Left" Style="{DynamicResource Button.Ghost}" Command="{Binding DataContext.FocusErrorCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.ErrorForeground}">
                                <Run Text="{Binding FieldPath}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ScrollViewer x:Name="EditorScroll" IsEnabled="{Binding CanInteract}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="RememberScroll">
            <StackPanel Width="{Binding ViewportWidth, ElementName=EditorScroll}">
                <Border Style="{DynamicResource Panel.Card}" Margin="{DynamicResource Margin.Field}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <HeaderedContentControl Header="Имя окружения" Style="{DynamicResource Form.Field}" Margin="{DynamicResource Margin.Related}">
                                <TextBox x:Name="NameInput" Tag="name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" MaxLength="256" AutomationProperties.AutomationId="EnvironmentName" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Grid.Column="1" Header="Неизменяемый ID" Style="{DynamicResource Form.Field}" Margin="0">
                                <TextBox Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="ID окружения" />
                            </HeaderedContentControl>
                        </Grid>
                        <TextBlock Text="{Binding ConfigurationSummary}" Style="{DynamicResource Text.Metadata}" Margin="0,8,0,8" />
                        <Expander Header="Описание">
                            <TextBox x:Name="DescriptionInput" Tag="description" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxLength="4096" AutomationProperties.Name="Описание окружения" Margin="{DynamicResource Margin.ScrollbarHorizontal}" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Grid x:Name="CatalogGrid" Margin="{DynamicResource Margin.Field}" IsEnabled="{Binding CanEdit}" SizeChanged="CatalogSizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TargetCatalog" Margin="0,0,6,0" Style="{DynamicResource Panel.Card}" Padding="{DynamicResource Padding.Panel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Box" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,14,0" />
                                    <TextBlock Text="Сервисы и проекты" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Выберите сервисы для включения в окружение. Зависимости добавляются автоматически." Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" Margin="40,4,0,16" />
                                <TextBox Style="{DynamicResource Input.Search}" Tag="Поиск сервисов..." Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск сервисов" Margin="{DynamicResource Margin.Field}" />
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="" />
                                    <TextBlock Grid.Column="1" Text="Название" Style="{DynamicResource Text.TableHeader}" />
                                    <TextBlock Grid.Column="2" Text="Источник" Style="{DynamicResource Text.TableHeader}" />
                                    <TextBlock Grid.Column="3" Text="Действия" Style="{DynamicResource Text.TableHeader}" />
                                </Grid>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TargetDefinitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid Height="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" Command="{Binding DataContext.ToggleDefinitionCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ChooseTargetService" AutomationProperties.Name="{Binding Definition.Name}" />
                                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <icons:PackIconLucide DockPanel.Dock="Left" Kind="Settings" Width="22" Height="22" Foreground="{DynamicResource Brush.ServiceIcon}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Definition.Name}" FontSize="{DynamicResource FontSize.Metadata}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                </DockPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="{DynamicResource Margin.SearchContent}" TextWrapping="Wrap" />
                                                <Button Grid.Column="3" Content="Ещё один" ToolTip="Добавить ещё один экземпляр сервиса" Command="{Binding DataContext.AddDefinitionCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.AccentText}" Margin="4,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                    <Border x:Name="InfrastructureCatalog" Grid.Column="1" Margin="6,0,0,0" Style="{DynamicResource Panel.Card}" Padding="{DynamicResource Padding.Panel}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Database" Width="26" Height="26" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,14,0" />
                                    <TextBlock Text="Инфраструктура" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Выберите инфраструктурные компоненты окружения." Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" Margin="40,4,0,16" />
                                <TextBox Style="{DynamicResource Input.Search}" Tag="Поиск компонентов..." Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск инфраструктуры" Margin="{DynamicResource Margin.Field}" />
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="" />
                                    <TextBlock Grid.Column="1" Text="Название" Style="{DynamicResource Text.TableHeader}" />
                                    <TextBlock Grid.Column="2" Text="Источник" Style="{DynamicResource Text.TableHeader}" />
                                    <TextBlock Grid.Column="3" Text="Действия" Style="{DynamicResource Text.TableHeader}" />
                                </Grid>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding InfrastructureDefinitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid Height="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" Command="{Binding DataContext.ToggleDefinitionCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" AutomationProperties.AutomationId="ChooseInfrastructureService" AutomationProperties.Name="{Binding Definition.Name}" />
                                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <icons:PackIconLucide DockPanel.Dock="Left" Kind="Database" Width="22" Height="22" Foreground="{DynamicResource Brush.InfrastructureIcon}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Definition.Name}" FontSize="{DynamicResource FontSize.Metadata}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                </DockPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="{DynamicResource Margin.SearchContent}" TextWrapping="Wrap" />
                                                <Button Grid.Column="3" Content="Ещё один" ToolTip="Добавить ещё один экземпляр сервиса" Command="{Binding DataContext.AddDefinitionCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="28" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.AccentText}" Margin="4,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </Grid>
                <DockPanel Margin="{DynamicResource Margin.Field}">
                    <Button DockPanel.Dock="Right" Content="Настроить сервисы" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="settings" />
                    <TextBlock Text="{Binding LibraryStatus}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" VerticalAlignment="Center" />
                </DockPanel>
                <Expander IsExpanded="False" Header="Дополнительно: импорт описания компонента" Margin="{DynamicResource Margin.Field}">
                    <StackPanel IsEnabled="{Binding CanEdit}" Margin="{DynamicResource Margin.Content}">
                        <TextBlock Text="{Binding LibraryStatus}" Style="{DynamicResource Text.Metadata}" />
                        <components:SpacedWrapPanel Margin="{DynamicResource Margin.ScrollbarHorizontal}">
                            <ComboBox ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedDefinition}" DisplayMemberPath="Label" Width="280" AutomationProperties.AutomationId="ComponentLibrary" />
                            <Button Content="Добавить компонент" Command="{Binding AddComponentCommand}" AutomationProperties.AutomationId="AddComponent" />
                            <Button Content="Импорт описания…" Command="{Binding ImportComponentCommand}" />
                        </components:SpacedWrapPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="Выбранный состав · настройки экземпляров" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Components}" Tag="components">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ComponentEditor />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <Expander Header="Зависимости экземпляров" IsExpanded="False" Margin="0,8,0,16" Tag="dependencies">
                        <StackPanel Margin="{DynamicResource Margin.Block}">
                            <TextBlock Text="Обязательная связь содержит причину включения. При нескольких подходящих экземплярах выберите нужный явно." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                            <ItemsControl ItemsSource="{Binding UnresolvedDependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Requirement.Reason}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" Margin="0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <components:SpacedWrapPanel Margin="{DynamicResource Margin.Block}">
                                <ComboBox ItemsSource="{Binding UnresolvedDependencies}" SelectedItem="{Binding SelectedRequirement}" DisplayMemberPath="Requirement.Id" Width="180" AutomationProperties.Name="Неразрешённое требование" />
                                <ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding SelectedRequiredInstance}" DisplayMemberPath="Label" Width="240" AutomationProperties.Name="Выбор экземпляра зависимости" />
                                <Button Content="Назначить" Command="{Binding BindRequirementCommand}" />
                            </components:SpacedWrapPanel>
                            <Button Content="Добавить связь" Command="{Binding AddDependencyCommand}" HorizontalAlignment="Left" />
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{DynamicResource Margin.Block}">
                                            <components:SpacedWrapPanel>
                                                <ComboBox ItemsSource="{Binding DataContext.ComponentChoices, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding DependentId}" Width="240" AutomationProperties.Name="Зависимый экземпляр" />
                                                <TextBlock Text=" → " VerticalAlignment="Center" />
                                                <ComboBox ItemsSource="{Binding DataContext.ComponentChoices, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding RequiredId}" Width="240" AutomationProperties.Name="Требуемый экземпляр" />
                                                <ComboBox ItemsSource="{x:Static local:DependencyEditor.Conditions}" SelectedItem="{Binding Condition}" Width="100" />
                                                <Button Content="×" Command="{Binding DataContext.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" AutomationProperties.Name="Удалить связь" Style="{DynamicResource Button.Icon}" />
                                            </components:SpacedWrapPanel>
                                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Причина зависимости" Margin="0,4" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Baseline и начальная инициализация" IsExpanded="False" Margin="{DynamicResource Margin.Section}" Tag="baseline">
                        <StackPanel Margin="{DynamicResource Margin.Block}">
                            <TextBlock Text="Применения выполняются по порядку. Для пакета укажите точные ID, version и contentHash; initializer остаётся сохранённым snapshot." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                            <components:SpacedWrapPanel Margin="{DynamicResource Margin.Block}">
                                <ComboBox ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding BaselineTarget}" DisplayMemberPath="Label" Width="300" AutomationProperties.Name="Целевой экземпляр baseline" />
                                <Button Content="Добавить initializer…" Command="{Binding AddBaselineCommand}" />
                            </components:SpacedWrapPanel>
                            <components:SpacedWrapPanel Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding PackChoices}" SelectedItem="{Binding SelectedPackChoice}" Width="350" AutomationProperties.Name="Точная версия SeedPack и initializer" />
                                <Button Content="Назначить пакет" Command="{Binding SelectSeedPackCommand}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="AssignSeedPack" />
                                <Button Content="Обновить список" Command="{Binding LoadPackChoicesCommand}" />
                            </components:SpacedWrapPanel>
                            <ItemsControl ItemsSource="{Binding Baseline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="{DynamicResource Padding.Dense}" Margin="{DynamicResource Margin.Block}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <components:SpacedWrapPanel DockPanel.Dock="Right">
                                                        <Button Content="Выше" IsEnabled="{Binding CanEdit}" Command="{Binding DataContext.MoveBaselineUpCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" />
                                                        <Button Content="Удалить" IsEnabled="{Binding CanEdit}" Command="{Binding DataContext.RemoveBaselineCommand, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" CommandParameter="{Binding}" />
                                                    </components:SpacedWrapPanel>
                                                    <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <ComboBox ItemsSource="{Binding DataContext.ComponentChoices, RelativeSource={RelativeSource AncestorType=local:EnvironmentEditorPage}}" SelectedValuePath="Id" DisplayMemberPath="Label" SelectedValue="{Binding ComponentId}" IsEnabled="{Binding CanEdit}" Margin="{DynamicResource Margin.Block}" AutomationProperties.Name="Назначение baseline" />
                                                <StackPanel IsEnabled="{Binding CanEdit}">
                                                    <CheckBox Content="Применить точный SeedPack" IsChecked="{Binding UsePack}" />
                                                    <components:SpacedWrapPanel Margin="{DynamicResource Margin.Block}">
                                                        <StackPanel Width="290">
                                                            <TextBlock Text="Pack ID" />
                                                            <TextBox Text="{Binding PackId, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Width="130">
                                                            <TextBlock Text="Version" />
                                                            <TextBox Text="{Binding PackVersion, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </components:SpacedWrapPanel>
                                                    <TextBlock Text="Content hash (SHA-256)" />
                                                    <TextBox Text="{Binding PackHash, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <Expander Header="Initializer snapshot (JSON)" Margin="{DynamicResource Margin.Block}">
                                                    <TextBox Text="{Binding InitializerJson, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsMandatory}" AcceptsReturn="True" AcceptsTab="False" FontFamily="{DynamicResource Font.Code}" Height="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Initializer snapshot" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Локальные пути" Margin="{DynamicResource Margin.Section}">
                        <StackPanel Margin="{DynamicResource Margin.Block}">
                            <TextBlock Text="Ссылка переносится с описанием; выбранная папка хранится только на этом компьютере. Выбор ничего не запускает." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                            <components:SpacedWrapPanel Margin="{DynamicResource Margin.Block}">
                                <TextBox Text="{Binding MappingReference, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="Локальная ссылка" />
                                <Button Content="Выбрать папку…" Command="{Binding ChooseFolderCommand}" />
                            </components:SpacedWrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Button Content="Проверить доступность входов" Command="{Binding CheckReadinessCommand}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.Block}" />
                <Expander Header="Полный сохранённый snapshot" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}" Margin="{DynamicResource Margin.Block}">
                    <TextBox Text="{Binding SavedDocumentJson, Mode=OneWay}" IsReadOnly="True" Height="300" AcceptsReturn="True" FontFamily="{DynamicResource Font.Code}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Expander>
                <ItemsControl ItemsSource="{Binding ReadinessIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.WarningForeground}" Margin="0,4">
                                <Run Text="{Binding FieldPath}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Code}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
