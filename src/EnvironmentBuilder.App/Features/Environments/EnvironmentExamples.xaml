<UserControl x:Class="EnvironmentBuilder.App.Features.Environments.EnvironmentExamples" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.PanelMuted}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock Text="Демонстрационные окружения · создайте окружение, чтобы начать работу" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Static local:EnvironmentExample.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid Height="60" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.7*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="156" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expand" IsChecked="{Binding InitiallyExpanded, Mode=OneTime}" Style="{DynamicResource Toggle.Row}" Width="24" Height="28" />
                                    <DockPanel Grid.Column="1" Margin="8,0,12,0">
                                        <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,0,18,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize.GroupTitle}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Width="30" Height="30" Margin="0,0,6,0">
                                            <icons:PackIconLucide Kind="Box" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Width="30" Height="30" Margin="0,0,6,0">
                                            <icons:PackIconLucide Kind="Settings" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Width="30" Height="30" Margin="0,0,6,0">
                                            <icons:PackIconLucide Kind="Code" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" />
                                        </Border>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Width="30" Height="30" Margin="0,0,6,0">
                                            <icons:PackIconLucide Kind="Globe" Foreground="{DynamicResource Brush.Accent}" Width="22" Height="22" />
                                        </Border>
                                        <Border Background="{DynamicResource Brush.PanelMuted}" CornerRadius="{DynamicResource Radius.Small}" Width="28" Height="28">
                                            <TextBlock Text="+1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <icons:PackIconLucide Kind="Database" Foreground="{DynamicResource Brush.InfrastructureIcon}" Width="24" Height="24" Margin="4,0,14,0" />
                                        <icons:PackIconLucide Kind="Component" Foreground="{DynamicResource Brush.ServiceIcon}" Width="24" Height="24" Margin="0,0,14,0" />
                                        <icons:PackIconLucide Kind="Layers" Foreground="{DynamicResource Brush.IconPrimary}" Width="22" Height="22" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="6 сервисов" FontSize="{DynamicResource FontSize.Metadata}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Status}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="8,0,16,0">
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CPU" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" />
                                            <Border Grid.Column="1" Background="{DynamicResource Brush.Divider}" Height="6" CornerRadius="{DynamicResource Radius.Progress}" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Brush.Accent}" Width="14" HorizontalAlignment="Left" CornerRadius="{DynamicResource Radius.Progress}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Память" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" />
                                            <Border Grid.Column="1" Background="{DynamicResource Brush.Divider}" Height="6" CornerRadius="{DynamicResource Radius.Progress}" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Brush.Accent}" Width="14" HorizontalAlignment="Left" CornerRadius="{DynamicResource Radius.Progress}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Memory}" FontSize="{DynamicResource FontSize.Small}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <components:SpacedWrapPanel Grid.Column="6" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                            <icons:PackIconLucide Kind="Play" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                            <icons:PackIconLucide Kind="Pencil" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                            <icons:PackIconLucide Kind="FileText" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                            <icons:PackIconLucide Kind="EllipsisVertical" Width="16" Height="16" />
                                        </Button>
                                    </components:SpacedWrapPanel>
                                </Grid>
                                <Border Margin="16,0,16,12" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Panel.Card}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=Expand}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Heading}" Background="{DynamicResource Brush.PanelMuted}">
                                            <TextBlock Text="Сервисы и инфраструктура (6)" FontWeight="SemiBold" />
                                        </Border>
                                        <ItemsControl ItemsSource="{x:Static local:EnvironmentExample.Services}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                                                        <Grid Height="42" Margin="16,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="1.6*" />
                                                                <ColumnDefinition Width="1.1*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="0.8*" />
                                                                <ColumnDefinition Width="1.1*" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="156" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="False" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{Binding Color}" Width="22" Height="22" Margin="8,0,24,0" />
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Metadata}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Style="{DynamicResource Badge.Info}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2">
                                                                <TextBlock Text="{Binding Category}" FontSize="{DynamicResource FontSize.Small}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding Source}" Style="{DynamicResource Text.Cell}" FontSize="{DynamicResource FontSize.Small}" />
                                                            <TextBlock Grid.Column="4" Text="8081:8080" Style="{DynamicResource Text.Cell}" FontSize="{DynamicResource FontSize.Small}" />
                                                            <TextBlock Grid.Column="5" Text="●  Запущен" Foreground="{DynamicResource Brush.SuccessForeground}" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Metadata}" />
                                                            <TextBlock Grid.Column="6" Text="CPU 0.12%       124 MB" Style="{DynamicResource Text.Cell}" FontSize="{DynamicResource FontSize.Small}" />
                                                            <components:SpacedWrapPanel Grid.Column="7" VerticalAlignment="Center">
                                                                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                                                    <icons:PackIconLucide Kind="Square" Width="16" Height="16" />
                                                                </Button>
                                                                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                                                    <icons:PackIconLucide Kind="ExternalLink" Width="16" Height="16" />
                                                                </Button>
                                                                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                                                    <icons:PackIconLucide Kind="FileText" Width="16" Height="16" />
                                                                </Button>
                                                                <Button Style="{DynamicResource Button.OutlineIcon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                                                    <icons:PackIconLucide Kind="EllipsisVertical" Width="16" Height="16" />
                                                                </Button>
                                                            </components:SpacedWrapPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
