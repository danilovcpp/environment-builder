<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.SettingsDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MinHeight="190" MaxHeight="230" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource Panel.Card}" Padding="16" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Параметры выбранного сервиса" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,12" />
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.SuccessBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5" Padding="9,6">
                            <StackPanel>
                                <TextBlock Text="{Binding ConfigurationStatus}" Foreground="{DynamicResource Brush.SuccessForeground}" FontSize="11" />
                                <TextBlock Text="{Binding ConfigurationHint}" Style="{DynamicResource Text.Metadata}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconLucide Kind="{Binding SelectedService.Icon}" Foreground="{Binding SelectedService.Color}" Width="30" Height="30" Margin="8,0,16,0" />
                            <TextBlock Text="{Binding SelectedService.Name}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border Style="{DynamicResource Reference.Badge}" CornerRadius="3" Padding="8,2">
                                <TextBlock Text="{Binding SelectedService.Category}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                <TabControl>
                    <TabItem Header="Основные">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,10,4,0">
                                <TextBlock Text="Источник образа" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Content="Готовый image" IsChecked="True" Margin="0,0,30,0" />
                                    <RadioButton Content="Build из папки" />
                                </StackPanel>
                                <TextBlock Text="Образ и тег" FontSize="12" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SelectedService.Source, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="latest" Margin="8,0,0,0" FontSize="12" />
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,8,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Политика загрузки" FontSize="12" Margin="0,0,0,6" />
                                        <ComboBox SelectedIndex="0" FontSize="12">
                                            <ComboBoxItem Content="IfNotPresent" />
                                            <ComboBoxItem Content="Always" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Платформа (опционально)" FontSize="12" Margin="0,0,0,6" />
                                        <ComboBox SelectedIndex="0" FontSize="12">
                                            <ComboBoxItem Content="linux/amd64" />
                                            <ComboBoxItem Content="linux/arm64" />
                                        </ComboBox>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="Сервисные настройки" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12" />
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ASPNETCORE_ENVIRONMENT" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="Development" FontSize="11" MinHeight="27" Padding="8,0" />
                                </Grid>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="URLS" FontSize="11" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="http://+:8080" FontSize="11" MinHeight="27" Padding="8,0" />
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox Content="Включить Swagger UI" IsChecked="True" Style="{DynamicResource Reference.Switch}" FontSize="12" />
                                        <TextBlock Text="Доступ к Swagger по /swagger." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="42,4,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox Content="Включить Hot Reload" Style="{DynamicResource Reference.Switch}" FontSize="12" />
                                        <TextBlock Text="Автоматическая перезагрузка при изменениях." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="42,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Переменные окружения">
                        <TextBlock Text="Переменные будут доступны в редакторе настроек." TextWrapping="Wrap" Margin="16" />
                    </TabItem>
                    <TabItem Header="Порты и тома">
                        <TextBlock Text="Порты и тома задаются в описании окружения." TextWrapping="Wrap" Margin="16" />
                    </TabItem>
                    <TabItem Header="Дополнительно">
                        <StackPanel Margin="16">
                            <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" />
                            <Button Content="Сменить тему" Command="{Binding ToggleThemeCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource Panel.Card}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Инфраструктурные пакеты" Style="{DynamicResource Text.SectionTitle}" />
                    <TextBlock Text="Базы данных, очереди и другие инфраструктурные компоненты." Style="{DynamicResource Text.Metadata}" Margin="0,4,0,10" />
                    <Grid Height="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="172" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название" Style="{DynamicResource Reference.TableHeader}" Margin="24,0" />
                        <TextBlock Grid.Column="1" Text="Источник" Style="{DynamicResource Reference.TableHeader}" />
                        <TextBlock Grid.Column="2" Text="Параметры" Style="{DynamicResource Reference.TableHeader}" />
                    </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Infrastructure}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="172" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{Binding Color}" Width="22" Height="22" Margin="8,0,18,0" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="1">
                                        <ContentControl.Content>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <RadioButton Content="Image" IsChecked="True" Style="{DynamicResource Toggle.Chip}" Padding="10,2" MinHeight="24" FontSize="11" />
                                                <RadioButton Content="Build из папки" IsChecked="{Binding Build, Mode=OneWay}" Style="{DynamicResource Toggle.Chip}" Padding="8,2" MinHeight="24" FontSize="11" />
                                            </StackPanel>
                                        </ContentControl.Content>
                                    </ContentControl>
                                    <TextBox Grid.Column="2" Text="{Binding Source, Mode=OneWay}" IsReadOnly="True" FontSize="11" MinHeight="25" Padding="6,0" Margin="4" />
                                    <Button Grid.Column="3" Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                        <icons:PackIconLucide Kind="EllipsisVertical" Width="14" Foreground="{DynamicResource Brush.Accent}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
