<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.SettingsDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible" /></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="Описание сервиса" Style="{DynamicResource Text.SectionTitle}" Margin="0,0,0,10" />
            <TextBlock Text="Добавьте источник, настройте внешний вид и зависимости целевого сервиса. Порты, переменные и хранилища задаются в окружении." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" Margin="{DynamicResource Margin.Field}" />
            <StackPanel DataContext="{Binding SelectedDefinition}">
                <HeaderedContentControl Header="Имя сервиса" Style="{DynamicResource Form.Field}">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.AutomationId="ServiceDefinitionName" />
                </HeaderedContentControl>
                <TextBlock Text="{Binding Type}" Style="{DynamicResource Text.Metadata}" Margin="{DynamicResource Margin.Field}" />
                <CheckBox Content="Показывать при создании окружения" IsChecked="{Binding Enabled}" Margin="{DynamicResource Margin.Field}" AutomationProperties.AutomationId="ServiceDefinitionEnabled" />
                <Grid Margin="{DynamicResource Margin.Field}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <HeaderedContentControl Header="Иконка" Style="{DynamicResource Form.Field}" Margin="0,0,8,0">
                        <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding Icon}" AutomationProperties.AutomationId="ServiceDefinitionIcon" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="1" Header="Цвет (#RRGGBB)" Style="{DynamicResource Form.Field}" Margin="0,0,8,0">
                        <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.AutomationId="ServiceDefinitionColor" />
                    </HeaderedContentControl>
                    <components:ServiceBadge Grid.Column="2" Icon="{Binding Icon}" Color="{Binding Color}" LogoUrl="{Binding Editor.LogoUrl}" VerticalAlignment="Bottom" Margin="0,0,8,7" />
                </Grid>
                <StackPanel DataContext="{Binding Editor}">
                    <HeaderedContentControl Header="Источник" Style="{DynamicResource Form.Field}">
                        <ComboBox ItemsSource="{Binding SourceKinds}" SelectedItem="{Binding SourceKind}" AutomationProperties.Name="Тип источника сервиса" />
                    </HeaderedContentControl>
                    <StackPanel Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                        <HeaderedContentControl Header="Образ" Style="{DynamicResource Form.Field}">
                            <TextBox Text="{Binding ImageReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Образ компонента" AutomationProperties.AutomationId="ServiceDefinitionImage" />
                        </HeaderedContentControl>
                        <StackPanel Visibility="{Binding IsInfrastructure, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding HubStatus}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" Margin="{DynamicResource Margin.Field}" AutomationProperties.AutomationId="DockerHubStatus" />
                            <ListBox ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}" MaxHeight="190" HorizontalContentAlignment="Stretch" Visibility="{Binding ShowRepositories, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="DockerHubResults">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" /><TextBlock Text="Официальный образ" Style="{DynamicResource Text.Metadata}" Visibility="{Binding IsOfficial, Converter={StaticResource Visible}}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <HeaderedContentControl Header="Версия / тег" Style="{DynamicResource Form.Field}">
                                <DockPanel><Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshVersionsCommand}" IsEnabled="{Binding CanLoadVersions}" Margin="8,0,0,0" /><ComboBox ItemsSource="{Binding Tags}" Text="{Binding SelectedTag, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="False" MaxDropDownHeight="240" AutomationProperties.AutomationId="DockerHubTags" /></DockPanel>
                            </HeaderedContentControl>
                            <Button Content="Загрузить ещё версии" Command="{Binding LoadMoreTagsCommand}" Visibility="{Binding HasMoreTags, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.Field}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsBuild, Converter={StaticResource Visible}}">
                        <HeaderedContentControl Header="Папка исходников" Style="{DynamicResource Form.Field}">
                            <DockPanel><Button DockPanel.Dock="Right" Content="Выбрать…" Command="{Binding ChooseSourceFolderCommand}" IsEnabled="{Binding CanChooseFolder}" Margin="8,0,0,0" /><TextBox Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ServiceDefinitionFolder" /></DockPanel>
                        </HeaderedContentControl>
                        <TextBlock Text="{Binding FolderError}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" />
                        <TextBlock Text="Dockerfile, контекст, аргументы и секреты сборки настраиваются в окружении." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding CanHaveDependencies, Converter={StaticResource Visible}}" Margin="0,16,0,0">
                    <TextBlock Text="Зависимости" Style="{DynamicResource Text.SectionTitle}" Margin="{DynamicResource Margin.Field}" />
                    <TextBlock Text="Выберите компоненты библиотеки. Обязательные добавятся в окружение автоматически; необязательные можно включить отдельно." Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource Margin.Field}" />
                    <ItemsControl ItemsSource="{Binding Dependencies}" AutomationProperties.AutomationId="ServiceDependencies">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource Panel.Card}" Padding="10" Margin="{DynamicResource Margin.Field}">
                                    <StackPanel>
                                        <DockPanel Margin="{DynamicResource Margin.Field}">
                                            <Button DockPanel.Dock="Right" Content="×" Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.SelectedDefinition.RemoveDependencyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Удалить зависимость" AutomationProperties.Name="Удалить зависимость" />
                                            <ComboBox ItemsSource="{Binding DataContext.SelectedDefinition.DependencyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="Name" AutomationProperties.Name="Компонент зависимости" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding MissingService}" Style="{DynamicResource Text.Optional}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.ErrorForeground}" />
                                        <CheckBox Content="Обязательная" IsChecked="{Binding IsRequired}" Margin="{DynamicResource Margin.Field}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Добавить зависимость" Command="{Binding AddDependencyCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AddServiceDependency" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
