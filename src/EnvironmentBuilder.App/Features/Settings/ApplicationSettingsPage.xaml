<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.ApplicationSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="920" HorizontalAlignment="Left">
            <Border Style="{DynamicResource Panel.Card}" Padding="20" Margin="{DynamicResource Margin.Field}">
                <StackPanel>
                    <TextBlock Text="Внешний вид" Style="{DynamicResource Text.SectionTitle}" Margin="{DynamicResource Margin.Field}" />
                    <HeaderedContentControl Header="Тема приложения" Style="{DynamicResource Form.Field}">
                        <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{x:Static local:ApplicationSettingsViewModel.Themes}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Theme}" AutomationProperties.AutomationId="ApplicationTheme" AutomationProperties.Name="Тема приложения" />
                    </HeaderedContentControl>
                    <CheckBox Content="Показывать описания окружений в списке" IsChecked="{Binding ShowDescriptions}" AutomationProperties.AutomationId="ShowEnvironmentDescriptions" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="20" Margin="{DynamicResource Margin.Field}">
                <StackPanel>
                    <TextBlock Text="Запуск" Style="{DynamicResource Text.SectionTitle}" Margin="{DynamicResource Margin.Field}" />
                    <HeaderedContentControl Header="Открывать при запуске" Style="{DynamicResource Form.Field}">
                        <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{x:Static local:ApplicationSettingsViewModel.StartPages}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding StartPage}" AutomationProperties.AutomationId="ApplicationStartPage" AutomationProperties.Name="Начальная страница" />
                    </HeaderedContentControl>
                    <TextBlock Text="Выбранный раздел откроется при следующем запуске приложения." Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Panel.Card}" Padding="20" Margin="{DynamicResource Margin.Field}">
                <StackPanel>
                    <TextBlock Text="О приложении и хранилище" Style="{DynamicResource Text.SectionTitle}" Margin="{DynamicResource Margin.Field}" />
                    <TextBlock Text="Environment Builder" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version, StringFormat=Версия {0}}" Style="{DynamicResource Text.Metadata}" Margin="0,4,0,12" />
                    <TextBlock Text="Локальное хранилище" Style="{DynamicResource Text.Metadata}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Путь к локальному хранилищу" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Status}" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" Margin="0,8,0,0" AutomationProperties.AutomationId="ApplicationSettingsError" />
            <Button Content="Повторить сохранение" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,8,0,12">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
