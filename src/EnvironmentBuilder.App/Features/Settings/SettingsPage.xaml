<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Settings">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Card}" Margin="0,0,0,12" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Реестр по умолчанию" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox Text="registry.local/eoffice" FontSize="12" />
                    <TextBlock Text="Используется для всех образов по умолчанию." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Политика тегов" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <ComboBox SelectedIndex="0" FontSize="12">
                        <ComboBoxItem Content="dev (по умолчанию)" />
                        <ComboBoxItem Content="latest" />
                        <ComboBoxItem Content="Фиксированная версия" />
                    </ComboBox>
                    <TextBlock Text="Тег образов, если не указан явно." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1,0" Padding="16,0">
                    <StackPanel>
                        <CheckBox IsChecked="True" Style="{DynamicResource Reference.Switch}" Content="Использовать локальный кэш образов" FontSize="12" />
                        <TextBlock Text="Ускоряет повторные сборки и запуск." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="42,4,0,12" />
                        <CheckBox IsChecked="True" Style="{DynamicResource Reference.Switch}" Content="Параллельный build" FontSize="12" />
                        <TextBlock Text="Собирать несколько сервисов одновременно." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="42,4,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                    <TextBlock Text="Папка workspace" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource Reference.PreviewAction}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Folder" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Выбрать папку" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="D:\src\eoffice" FontSize="12" />
                    </DockPanel>
                    <TextBlock Text="Базовая папка для локальной сборки сервисов." Style="{DynamicResource Text.Metadata}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="16,10,0,4">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconLucide Kind="CircleCheck" Foreground="{DynamicResource Brush.SuccessForeground}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding ServiceCount}" Style="{DynamicResource Text.Metadata}" VerticalAlignment="Center" />
                <TextBlock Text="   |   " Foreground="{DynamicResource Brush.TextTertiary}" />
                <icons:PackIconLucide Kind="Info" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,12,0" />
                <TextBlock Text="4 сервиса собираются локально" Style="{DynamicResource Text.Metadata}" VerticalAlignment="Center" />
                <TextBlock Text="   |   " Foreground="{DynamicResource Brush.TextTertiary}" />
                <TextBlock Text="{Binding ExampleNotice}" Style="{DynamicResource Text.Metadata}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.52*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Panel.Card}" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Показывать отключённые" Style="{DynamicResource Reference.Switch}" FontSize="11" IsChecked="False" />
                            <TextBlock Text="Поддерживаемые сервисы" Style="{DynamicResource Text.SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="Настройте источники образов и параметры сборки для всех сервисов." Style="{DynamicResource Text.Metadata}" Margin="0,5,0,10" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск сервисов..." AutomationProperties.Name="Поиск компонентов" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <Button Content="Все" Command="{Binding FilterCategoryCommand}" CommandParameter="Все" Margin="6,0,0,0" Padding="14,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Все">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Backend" Command="{Binding FilterCategoryCommand}" CommandParameter="Backend" Margin="6,0,0,0" Padding="14,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Backend">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Frontend" Command="{Binding FilterCategoryCommand}" CommandParameter="Frontend" Margin="6,0,0,0" Padding="14,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Frontend">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Infrastructure" Command="{Binding FilterCategoryCommand}" CommandParameter="Infrastructure" Margin="6,0,0,0" Padding="14,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Infrastructure">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Custom" Command="{Binding FilterCategoryCommand}" CommandParameter="Custom" Margin="6,0,0,0" Padding="14,5">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Custom">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DisplayDefinitions}" SelectedItem="{Binding SelectedService}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="32" ColumnHeaderHeight="32" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SettingsDefinitions">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="35">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Название" Width="1.45*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:PackIconLucide Kind="{Binding Icon}" Foreground="{Binding Color}" Margin="0,0,16,0" Width="20" Height="20" />
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Категория" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource Reference.Badge}" CornerRadius="3" Padding="7,2">
                                            <TextBlock Text="{Binding Category}" FontSize="10" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Источник" Width="172">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Content="Image" IsChecked="True" Style="{DynamicResource Toggle.Chip}" Padding="10,2" MinHeight="24" FontSize="11" />
                                            <RadioButton Content="Build из папки" IsChecked="{Binding Build, Mode=OneWay}" Style="{DynamicResource Toggle.Chip}" Padding="8,2" MinHeight="24" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Параметры" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Margin="4,3" Height="25" Background="{DynamicResource Brush.Input}">
                                            <TextBlock Text="{Binding Source}" FontSize="11" Margin="8,0" VerticalAlignment="Center" ToolTip="{Binding Source}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действия" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}">
                                            <icons:PackIconLucide Kind="EllipsisVertical" Foreground="{DynamicResource Brush.Accent}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <local:SettingsDetails Grid.Column="1" />
        </Grid>
    </DockPanel>
</UserControl>
