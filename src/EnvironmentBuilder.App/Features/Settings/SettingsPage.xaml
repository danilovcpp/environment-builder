<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.SettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
  <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Card}" Margin="0,0,0,12"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Сменить тему" Command="{Binding ToggleThemeCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Каталог данных" FontWeight="SemiBold"/><TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" AutomationProperties.Name="Каталог данных"/></StackPanel></DockPanel><TextBlock Text="Сохранённые окружения используют собственные настройки и snapshots." Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{DynamicResource Panel.Card}" Padding="0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="12"><TextBlock Text="Библиотека компонентов" Style="{DynamicResource Text.SectionTitle}"/><TextBlock Text="{Binding Status}" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" Margin="0,4,0,8"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск…" AutomationProperties.Name="Поиск компонентов" ToolTip="Поиск компонентов"/></StackPanel>
    <DataGrid ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SettingsDefinitions"><DataGrid.Columns><DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Категория" Binding="{Binding Type}" Width="140"/><DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="80"/></DataGrid.Columns></DataGrid>
   </DockPanel></Border>
   <Border Grid.Row="1" Style="{DynamicResource Panel.Card}" Margin="0,12,0,0"><Expander Header="Локальные пути и defaults"><StackPanel Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding Paths}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding WorkflowReason}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}"/><Button Content="Сохранить defaults" IsEnabled="False" ToolTip="{Binding WorkflowReason}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander></Border>
  </Grid>
 </DockPanel>
</UserControl>
