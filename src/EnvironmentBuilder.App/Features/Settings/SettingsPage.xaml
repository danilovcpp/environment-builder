<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Settings">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Card}" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Библиотека сервисов" Style="{DynamicResource Text.SectionTitle}" />
                <TextBlock Text="Добавьте свои приложения и инфраструктуру. Включённые сервисы появятся при создании окружения после сохранения настроек." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsError" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsStatus" />
            <TextBlock Text="{Binding ServiceCount}" Style="{DynamicResource Text.Metadata}" Margin="0,4,0,0" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Panel.Card}" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Добавить сервис" Command="{Binding AddTargetCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="AddTargetService" />
                            <Button Content="Добавить инфраструктуру" Command="{Binding AddInfrastructureCommand}" Margin="0,0,0,8" AutomationProperties.AutomationId="AddInfrastructureService" />
                        </WrapPanel>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск сервисов…" Margin="0,0,0,12" AutomationProperties.Name="Поиск компонентов" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" AutoGenerateColumns="False" IsReadOnly="False" IsEnabled="{Binding CanConfigure}" RowHeight="38" ColumnHeaderHeight="34" BorderThickness="0" AutomationProperties.AutomationId="SettingsDefinitions">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="В выборе" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                            <DataGridTextColumn Header="Сервис" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" IsReadOnly="True" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource Panel.Card}" Padding="14">
                <local:SettingsDetails />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
