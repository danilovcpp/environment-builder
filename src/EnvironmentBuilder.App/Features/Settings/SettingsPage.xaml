<UserControl x:Class="EnvironmentBuilder.App.Features.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.Settings" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Card}" Padding="{DynamicResource Padding.Panel}" Margin="{DynamicResource Margin.Field}">
            <StackPanel>
                <TextBlock Text="Библиотека сервисов" Style="{DynamicResource Text.SectionTitle}" />
                <TextBlock Text="Добавьте свои приложения и инфраструктуру. Включённые сервисы появятся при создании окружения после сохранения библиотеки." TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsError" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsStatus" />
            <TextBlock Text="{Binding ServiceCount}" Style="{DynamicResource Text.Metadata}" Margin="0,4,0,0" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Panel.Card}" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <components:SpacedWrapPanel Margin="{DynamicResource Margin.Field}">
                            <Button Content="Добавить сервис" Command="{Binding AddTargetCommand}" AutomationProperties.AutomationId="AddTargetService" />
                            <Button Content="Добавить инфраструктуру" Command="{Binding AddInfrastructureCommand}" AutomationProperties.AutomationId="AddInfrastructureService" />
                        </components:SpacedWrapPanel>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск сервисов…" Margin="{DynamicResource Margin.Field}" AutomationProperties.Name="Поиск компонентов" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" AutoGenerateColumns="False" IsReadOnly="False" IsEnabled="{Binding CanConfigure}" RowHeight="38" ColumnHeaderHeight="34" BorderThickness="0" AutomationProperties.AutomationId="SettingsDefinitions">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CheckBox.TableDisplay}" EditingElementStyle="{StaticResource CheckBox.Table}" />
                            <DataGridTemplateColumn Header="Сервис" IsReadOnly="True" Width="*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><components:ServiceBadge DockPanel.Dock="Left" Icon="{Binding Icon}" Color="{Binding Color}" LogoUrl="{Binding Editor.LogoUrl}" Margin="0,0,8,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" IsReadOnly="True" Width="0.85*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource Panel.Card}" Padding="14">
                <local:SettingsDetails />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
