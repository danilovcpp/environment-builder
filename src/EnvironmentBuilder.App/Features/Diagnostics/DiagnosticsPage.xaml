<UserControl x:Class="EnvironmentBuilder.App.Features.Diagnostics.DiagnosticsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border Style="{DynamicResource Panel.Card}" Margin="0,0,0,12"><StackPanel><StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Database" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,8,0"/><TextBlock Text="Локальное хранилище" Style="{DynamicResource Text.SectionTitle}"/></StackPanel><TextBlock Text="{Binding StorageStatus}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}"/></StackPanel></Border>
  <Border Style="{DynamicResource Panel.Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Незавершённые операции" Style="{DynamicResource Text.SectionTitle}"/><TextBlock Text="{Binding RecoveryStatus}" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="{Binding WorkflowReason}" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" Margin="0,12,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="Сверить операции" IsEnabled="False" ToolTip="{Binding WorkflowReason}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/><Button Content="Экспорт диагностики" IsEnabled="False" ToolTip="{Binding WorkflowReason}" ToolTipService.ShowOnDisabled="True"/></WrapPanel></StackPanel></Border>
  <Border Style="{DynamicResource Panel.Card}"><StackPanel><TextBlock Text="Runtime и наблюдение" Style="{DynamicResource Text.SectionTitle}"/><TextBlock Text="{Binding RuntimeStatus}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
