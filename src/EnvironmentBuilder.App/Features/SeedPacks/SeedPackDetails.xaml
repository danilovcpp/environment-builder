<UserControl x:Class="EnvironmentBuilder.App.Features.SeedPacks.SeedPackDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource Panel.Card}" Padding="0" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Database" Style="{DynamicResource Reference.Icon}" Width="18" Height="18" />
                        <TextBlock Text="Сводка выбранного пака" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="14,10">
                    <DockPanel Margin="0,0,0,10">
                        <icons:PackIconLucide Kind="BriefcaseBusiness" DockPanel.Dock="Left" Width="30" Height="30" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,18,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDisplayPack.Title}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Style="{DynamicResource Text.Metadata}" Margin="0,3,0,0">
                                <Run Text="{Binding SelectedDisplayPack.Theme}" />
                                <Run Text=" / Generic   |   " />
                                <Run Text="{Binding SelectedDisplayPack.Version}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="6,2">
                        <icons:PackIconLucide Kind="UserRound" Width="14" Height="14" Foreground="{DynamicResource Brush.IconPrimary}" Margin="0,0,18,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDisplayPack.Users, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Пользователи" Style="{DynamicResource Text.Metadata}" />
                    </DockPanel>
                    <DockPanel Margin="6,2">
                        <icons:PackIconLucide Kind="CalendarDays" Width="14" Height="14" Foreground="{DynamicResource Brush.IconPrimary}" Margin="0,0,18,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDisplayPack.Events, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Календарные события" Style="{DynamicResource Text.Metadata}" />
                    </DockPanel>
                    <DockPanel Margin="6,2">
                        <icons:PackIconLucide Kind="MessageCircle" Width="14" Height="14" Foreground="{DynamicResource Brush.IconPrimary}" Margin="0,0,18,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDisplayPack.Chats, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Чаты" Style="{DynamicResource Text.Metadata}" />
                    </DockPanel>
                    <DockPanel Margin="6,2">
                        <icons:PackIconLucide Kind="FileText" Width="14" Height="14" Foreground="{DynamicResource Brush.IconPrimary}" Margin="0,0,18,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDisplayPack.Documents, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Документы" Style="{DynamicResource Text.Metadata}" />
                    </DockPanel>
                    <DockPanel Margin="6,2">
                        <icons:PackIconLucide Kind="Network" Width="14" Height="14" Foreground="{DynamicResource Brush.IconPrimary}" Margin="0,0,18,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDisplayPack.Departments, TargetNullValue=—}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="Отделы" Style="{DynamicResource Text.Metadata}" />
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="2,6,0,0">
                        <TextBlock Text="Теги и особенности" FontSize="12" />
                    </Border>
                    <WrapPanel Margin="2,6,0,0">
                        <Border Background="{DynamicResource Brush.InfoBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="9,3" Margin="0,0,8,5">
                            <TextBlock Text="Реалистичные имена" FontSize="11" Foreground="{DynamicResource Brush.InfoForeground}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.InfoBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="9,3" Margin="0,0,8,5">
                            <TextBlock Text="RU locale" FontSize="11" Foreground="{DynamicResource Brush.InfoForeground}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.WarningBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="9,3" Margin="0,0,8,5">
                            <TextBlock Text="Демо" FontSize="11" Foreground="{DynamicResource Brush.WarningForeground}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.SuccessBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="7" Padding="9,3" Margin="0,0,8,5">
                            <TextBlock Text="Совместим с Calendar/Meetings" FontSize="11" Foreground="{DynamicResource Brush.SuccessForeground}" />
                        </Border>
                    </WrapPanel>
                    <DockPanel Margin="2,4,2,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <icons:PackIconLucide Kind="HardDrive" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SelectedDisplayPack.DiskSize}" />
                        </StackPanel>
                        <TextBlock Text="Размер пака" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <Border Background="{DynamicResource Brush.SuccessBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                        <DockPanel>
                            <icons:PackIconLucide Kind="CircleCheck" Foreground="{DynamicResource Brush.SuccessForeground}" Width="26" Height="26" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDisplayPack.ValidationTitle}" Foreground="{DynamicResource Brush.SuccessForeground}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding SelectedDisplayPack.ValidationDetail}" Style="{DynamicResource Text.Metadata}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,5,0" Padding="7,5">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Pencil" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Редактировать метаданные" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{DynamicResource Reference.PreviewAction}" Margin="5,0,0,0" Padding="7,5">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Upload" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Экспорт пак" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource Panel.Card}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Reference.Icon}" Width="18" Height="18" />
                        <TextBlock Text="Текстовое preview" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">
                        <StackPanel Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <icons:PackIconLucide Kind="UserRound" Foreground="{DynamicResource Brush.Accent}" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="Пример пользователя" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <Border Style="{DynamicResource Panel.Card}" Background="{DynamicResource Brush.Hover}" Padding="8,5" Margin="16,0,0,0">
                                <TextBlock FontSize="11" TextWrapping="Wrap">
                                    <Run Text="Ирина Волкова — HR Manager — " />
                                    <Run Text="irina.volkova@office.local" Foreground="{DynamicResource Brush.AccentText}" TextDecorations="Underline" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <icons:PackIconLucide Kind="CalendarDays" Foreground="{DynamicResource Brush.Accent}" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="Пример календарного события" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <Border Style="{DynamicResource Panel.Card}" Padding="12,8" Margin="24,0,0,0" BorderThickness="3,1,1,1" BorderBrush="{DynamicResource Brush.BorderStrong}">
                                <StackPanel>
                                    <TextBlock Text="Weekly Product Sync" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="◷   Пн, 11:00–11:45" Style="{DynamicResource Text.Metadata}" FontSize="11" Margin="0,6,0,0" />
                                    <TextBlock Text="Организатор: Алексей Смирнов" Style="{DynamicResource Text.Metadata}" FontSize="11" Margin="0,4" />
                                    <TextBlock Text="Участники: Ирина Волкова, Мария Соколова" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                    <TextBlock Text="Обсуждение статуса задач, блокеров и планов на неделю." Style="{DynamicResource Text.Metadata}" FontSize="11" TextWrapping="Wrap" Margin="0,4" />
                                    <TextBlock Text="Переговорная Orion / Teams" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <icons:PackIconLucide Kind="MessageSquare" Foreground="{DynamicResource Brush.Accent}" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="Пример чат-сообщения" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <Border Background="{DynamicResource Brush.PanelMuted}" CornerRadius="6" Padding="8" Margin="16,0,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <Border Background="{DynamicResource Brush.Accent}" Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0">
                                            <TextBlock Text="АС" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontSize="11">
                                                <Run Text="Алексей Смирнов" FontWeight="SemiBold" />
                                                <Run Text="   10:14" Foreground="{DynamicResource Brush.TextTertiary}" />
                                            </TextBlock>
                                            <TextBlock Text="Коллеги, всем привет! Подготовил материалы к встрече." FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <Border Background="{DynamicResource Brush.Accent}" Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0">
                                            <TextBlock Text="ИВ" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontSize="11">
                                                <Run Text="Ирина Волкова" FontWeight="SemiBold" />
                                                <Run Text="   10:16" Foreground="{DynamicResource Brush.TextTertiary}" />
                                            </TextBlock>
                                            <TextBlock Text="Отлично, посмотрю. Давайте обсудим на синке." FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,9">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <icons:PackIconLucide Kind="FileText" Foreground="{DynamicResource Brush.Accent}" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="Пример документа" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <Border Style="{DynamicResource Panel.Card}" Padding="10,6" Margin="24,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quarterly Planning Notes" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Microsoft Word (docx)  ·  245 KB" Style="{DynamicResource Text.Metadata}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Пример содержимого · данные preview" Style="{DynamicResource Text.Metadata}" FontSize="10" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
