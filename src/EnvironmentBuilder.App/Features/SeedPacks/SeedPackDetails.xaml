<UserControl x:Class="EnvironmentBuilder.App.Features.SeedPacks.SeedPackDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:local="clr-namespace:EnvironmentBuilder.App.Features.SeedPacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource Panel.Card}" Padding="0" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Heading}" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="Database" Style="{DynamicResource Icon.Section}" Width="18" Height="18" />
                        <TextBlock Text="Сводка выбранного пака" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="14,10">
                    <DockPanel Margin="0,0,0,10">
                        <icons:PackIconLucide Kind="BriefcaseBusiness" DockPanel.Dock="Left" Width="30" Height="30" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,18,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDisplayPack.Title}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.SectionTitle}" />
                            <TextBlock Style="{DynamicResource Text.Metadata}" Margin="0,3,0,0">
                                <Run Text="{Binding SelectedDisplayPack.Theme, Mode=OneWay}" />
                                <Run Text="   |   " />
                                <Run Text="{Binding SelectedDisplayPack.Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding SelectedPack.Manifest.Sections}"><ItemsControl.ItemTemplate><DataTemplate>
                        <DockPanel Margin="6,2"><icons:PackIconLucide Kind="Database" Width="14" Height="14" Foreground="{DynamicResource Brush.IconPrimary}" Margin="0,0,18,0" /><TextBlock DockPanel.Dock="Right" Text="{Binding RecordCount}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Metadata}" /><TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Metadata}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" /></DockPanel>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="2,6,0,0">
                        <TextBlock Text="Теги и особенности" FontSize="{DynamicResource FontSize.Metadata}" />
                    </Border>
                    <components:SpacedWrapPanel Margin="2,6,0,0">
                        <Border Background="{DynamicResource Brush.InfoBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Badge}" Padding="9,3">
                            <TextBlock Text="{Binding SelectedPack.Theme}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.InfoForeground}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.InfoBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Badge}" Padding="9,3">
                            <TextBlock Text="JSON / NDJSON" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.InfoForeground}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.WarningBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Badge}" Padding="9,3">
                            <TextBlock Text="{Binding SelectedPack.Version}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.WarningForeground}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.SuccessBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Badge}" Padding="9,3">
                            <TextBlock Text="{Binding SelectedPack.Compatibility}" TextTrimming="CharacterEllipsis" MaxWidth="220" ToolTip="{Binding SelectedPack.Compatibility}" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.SuccessForeground}" />
                        </Border>
                    </components:SpacedWrapPanel>
                    <DockPanel Margin="2,4,2,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <icons:PackIconLucide Kind="HardDrive" Width="14" Height="14" Margin="{DynamicResource Margin.Related}" />
                            <TextBlock Text="{Binding SelectedDisplayPack.DiskSize}" />
                        </StackPanel>
                        <TextBlock Text="Размер пака" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </DockPanel>
                    <Border Background="{DynamicResource Brush.SuccessBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Padding="10,6">
                        <DockPanel>
                            <icons:PackIconLucide Kind="CircleCheck" Foreground="{DynamicResource Brush.SuccessForeground}" Width="26" Height="26" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDisplayPack.ValidationTitle}" Foreground="{DynamicResource Brush.SuccessForeground}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Metadata}" />
                                <TextBlock Text="{Binding SelectedDisplayPack.ValidationDetail}" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding OwnersCommand}" Style="{DynamicResource Button.Accent}" Margin="0,0,5,0" Padding="7,5">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Users" Width="16" Height="16" Margin="{DynamicResource Margin.Related}" />
                                <TextBlock Text="Кто использует пакет" FontSize="{DynamicResource FontSize.Metadata}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding CopyIdentityCommand}" Style="{DynamicResource Button.Accent}" Margin="5,0,0,0" Padding="7,5">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Copy" Width="16" Height="16" Margin="{DynamicResource Margin.Related}" />
                                <TextBlock Text="Копировать ID" FontSize="{DynamicResource FontSize.Metadata}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{DynamicResource Panel.Card}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Heading}" Padding="12,9">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Icon.Section}" Width="18" Height="18" />
                        <TextBlock Text="Текстовое preview" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <local:SeedPackPreview DataContext="{Binding Preview}" Margin="12,8" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
