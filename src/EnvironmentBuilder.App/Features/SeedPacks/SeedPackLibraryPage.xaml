
<UserControl x:Class="EnvironmentBuilder.App.Features.SeedPacks.SeedPackLibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Style="{StaticResource Layout.PageCanvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.65*" MinHeight="230" />
      <RowDefinition Height="*" MinHeight="180" />
    </Grid.RowDefinitions>
    <components:SpacedWrapPanel Margin="{DynamicResource Margin.Field}" Spacing="{DynamicResource Spacing.12}">
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск паков..." Width="{DynamicResource Size.Search}" AutomationProperties.Name="Поиск пакетов" />
      <RadioButton Content="Все" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Все}" Command="{Binding FilterThemeCommand}" CommandParameter="Все" />
      <RadioButton Content="Generic" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Generic}" Command="{Binding FilterThemeCommand}" CommandParameter="Generic" />
      <RadioButton Content="Fantasy" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Fantasy}" Command="{Binding FilterThemeCommand}" CommandParameter="Fantasy" />
      <RadioButton Content="Sci-Fi" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Sci-Fi}" Command="{Binding FilterThemeCommand}" CommandParameter="Sci-Fi" />
      <RadioButton Content="Office" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Office}" Command="{Binding FilterThemeCommand}" CommandParameter="Office" />
      <RadioButton Content="Большие" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Большие}" Command="{Binding FilterThemeCommand}" CommandParameter="Большие" />
      <RadioButton Content="Избранные" GroupName="SeedPackFilter" Style="{DynamicResource Toggle.Chip}" IsChecked="{Binding DisplayFilter, Mode=OneWay, Converter={StaticResource SelectionEquals}, ConverterParameter=Избранные}" Command="{Binding FilterThemeCommand}" CommandParameter="Избранные" IsEnabled="False" ToolTip="Избранные пакеты пока не настроены" ToolTipService.ShowOnDisabled="True" />
    </components:SpacedWrapPanel>
    <Grid Grid.Row="1" Margin="{DynamicResource Margin.Field}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Style="{DynamicResource Panel.Metric}" Margin="0,0,6,0">
        <DockPanel>
          <Border Style="{DynamicResource Icon.Metric}">
            <icons:PackIconLucide Kind="Layers" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayCount}" FontSize="{DynamicResource FontSize.Kpi}" FontWeight="SemiBold" />
            <TextBlock Text="Всего паков" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Panel.Metric}" Grid.Column="1" Margin="6,0">
        <DockPanel>
          <Border Style="{DynamicResource Icon.Metric}">
            <icons:PackIconLucide Kind="Tag" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding InstalledCount}" FontSize="{DynamicResource FontSize.Kpi}" FontWeight="SemiBold" />
            <TextBlock Text="Записей" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Panel.Metric}" Grid.Column="2" Margin="6,0">
        <DockPanel>
          <Border Style="{DynamicResource Icon.Metric}">
            <icons:PackIconLucide Kind="HardDrive" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplaySize}" FontSize="{DynamicResource FontSize.Kpi}" FontWeight="SemiBold" />
            <TextBlock Text="Общий размер" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Panel.Metric}" Grid.Column="3" Margin="6,0,0,0">
        <DockPanel>
          <Border Style="{DynamicResource Icon.Metric}">
            <icons:PackIconLucide Kind="Network" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding EntityCount}" FontSize="{DynamicResource FontSize.Kpi}" FontWeight="SemiBold" />
            <TextBlock Text="Поддерживаемых сущностей" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{DynamicResource Panel.Card}" Padding="0" Margin="{DynamicResource Margin.Field}" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Heading}" Padding="16,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <icons:PackIconLucide Kind="List" Style="{DynamicResource Icon.Section}" />
              <TextBlock Text="Доступные data-seed паки" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ImportCommand}" AutomationProperties.AutomationId="ImportSeedPack" Style="{DynamicResource Button.Accent}" Background="{DynamicResource Brush.DropzoneBackground}" BorderBrush="{DynamicResource Brush.DropzoneBorder}" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <icons:PackIconLucide Kind="CloudUpload" Margin="0,0,12,0" Width="28" Height="28" />
                <TextBlock Text="Внешний пакет .zip с manifest.json&#xA;или нажмите для выбора ZIP" TextWrapping="Wrap" FontSize="{DynamicResource FontSize.Metadata}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,4"><TextBlock Text="{Binding Progress}" Style="{DynamicResource Text.Optional}" /><Button Content="Отменить импорт" Command="{Binding ImportCancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" HorizontalAlignment="Left" /><TextBlock Text="Библиотека пуста. Импортируйте внешний ZIP." Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" /><TextBlock Text="По заданным условиям пакеты не найдены." Visibility="{Binding NoResults, Converter={StaticResource Visible}}" /></StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" Margin="12,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ExampleNotice}" Style="{DynamicResource Text.Optional}" FontSize="{DynamicResource FontSize.Caption}" Margin="16,2" />
        <TextBlock DockPanel.Dock="Bottom" Text="Чтение библиотеки…" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" Margin="12,4" />
        <DataGrid ItemsSource="{Binding DisplayItems}" SelectedItem="{Binding SelectedDisplayPack}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SeedPackRows" FontSize="{DynamicResource FontSize.Metadata}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40">
              <DataGridTemplateColumn.Header>
                <CheckBox IsChecked="False" IsHitTestVisible="False" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" IsHitTestVisible="False" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Название пака" Width="2.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:PackIconLucide Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource Brush.AccentText}" Margin="4,0,14,0" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Metadata}" ToolTip="{Binding Title}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Тема" Width="0.95*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Badge.Info}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Theme}" Value="Fantasy">
                            <Setter Property="Background" Value="{DynamicResource Brush.PurpleBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PurpleForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Theme}" Value="Sci-Fi">
                            <Setter Property="Background" Value="{DynamicResource Brush.ErrorBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.ErrorForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Theme}" Value="Generic">
                            <Setter Property="Background" Value="{DynamicResource Brush.NeutralBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.NeutralForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Theme}" FontSize="{DynamicResource FontSize.Small}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Размер" Width="0.85*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Badge.Info}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Size}" Value="Large">
                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarningForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Size}" Value="XL">
                            <Setter Property="Background" Value="{DynamicResource Brush.PurpleBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PurpleForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Size}" Value="Small">
                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Size}" FontSize="{DynamicResource FontSize.Small}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Секции / записи" Binding="{Binding Entities}" Width="2.35*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
            <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="0.75*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
            <DataGridTemplateColumn Header="Статус" Width="1.25*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Badge.Info}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Installed}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Черновик">
                            <Setter Property="Background" Value="{DynamicResource Brush.NeutralBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.NeutralForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="{DynamicResource FontSize.Caption}">
                      <Run Text="● " />
                      <Run Text="{Binding Status, Mode=OneWay}" />
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Действия" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <components:SpacedWrapPanel>
                    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.ViewPackCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Просмотр">
                      <icons:PackIconLucide Kind="Eye" />
                    </Button>
                    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.CopyIdentityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Копировать идентичность">
                      <icons:PackIconLucide Kind="Copy" />
                    </Button>
                    <Button Style="{DynamicResource Button.Icon}" Command="{Binding DataContext.PackOwnersCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Кто использует пакет">
                      <icons:PackIconLucide Kind="Ellipsis" />
                    </Button>
                  </components:SpacedWrapPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Row="3" Style="{DynamicResource Panel.Card}" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Panel.Heading}">
          <StackPanel Orientation="Horizontal">
            <icons:PackIconLucide Kind="NotebookText" Style="{DynamicResource Icon.Section}" />
            <TextBlock Text="Структура и содержимое пака" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <TabControl SelectedIndex="{Binding SelectedTab}">
          <TabItem Header="Сущности">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="12,6,12,8" MinHeight="190">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.6*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,10,0">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,2">
                    <icons:PackIconLucide Kind="NotebookText" Style="{DynamicResource Icon.Section}" Width="16" Height="16" Margin="{DynamicResource Margin.Related}" />
                    <TextBlock Text="Включённые сущности" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Metadata}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding SelectedPack.Manifest.Sections}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                        <DockPanel><icons:PackIconLucide Kind="Database" Style="{DynamicResource Icon.Section}" VerticalAlignment="Top" Margin="0,3,12,0" />
                          <StackPanel><TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSize.Small}" TextWrapping="Wrap" /><TextBlock Text="{Binding RecordCount}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Value}" /><TextBlock Text="{Binding Id}" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" /></StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="{DynamicResource Margin.ScrollbarVertical}">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <icons:PackIconLucide Kind="Settings" Style="{DynamicResource Icon.Section}" Width="16" Height="16" Margin="{DynamicResource Margin.Related}" />
                    <TextBlock Text="Параметры пакета" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Metadata}" />
                  </StackPanel>
                  <StackPanel>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Тема" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPack.Theme}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Назначение" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPack.Manifest.Purpose}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Версия" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPack.Version}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Секций" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPack.SectionCount}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Initializer-ов" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPack.InitializerCount}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Совместимость" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedPack.Compatibility}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Формат" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="JSON / NDJSON" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource FontSize.Caption}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Поля">
            <DataGrid ItemsSource="{Binding SelectedPack.Manifest.Sections}" AutoGenerateColumns="False" IsReadOnly="True" Margin="{DynamicResource Margin.Content}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Секция" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
                <DataGridTextColumn Header="Записей" Binding="{Binding RecordCount}" Width="100" ElementStyle="{StaticResource Text.Table}" EditingElementStyle="{StaticResource Input.Table}" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Правила генерации">
            <TextBlock Text="Правила генерации будут доступны после подключения редактора паков." TextWrapping="Wrap" Margin="16" />
          </TabItem>
          <TabItem Header="Валидация">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" /><Button Content="Кто использует пакет" Command="{Binding OwnersCommand}" Margin="{DynamicResource Margin.Block}" HorizontalAlignment="Left" /><TextBlock Text="{Binding OwnerStatus}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Owners}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" ToolTip="{Binding Id}" Command="{Binding DataContext.OpenOwnerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
