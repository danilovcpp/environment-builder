<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="EnvironmentBuilder.App.Features.SeedPacks.SeedPackLibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.65*" MinHeight="230" />
      <RowDefinition Height="*" MinHeight="180" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.36*" />
        <ColumnDefinition Width="0.64*" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource Input.Search}" Tag="Поиск паков..." AutomationProperties.Name="Поиск пакетов" />
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
          <Button Content="Все" Command="{Binding FilterThemeCommand}" CommandParameter="Все" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Все">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Generic" Command="{Binding FilterThemeCommand}" CommandParameter="Generic" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Generic">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Fantasy" Command="{Binding FilterThemeCommand}" CommandParameter="Fantasy" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Fantasy">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Sci-Fi" Command="{Binding FilterThemeCommand}" CommandParameter="Sci-Fi" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Sci-Fi">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Office" Command="{Binding FilterThemeCommand}" CommandParameter="Office" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Office">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Большие" Command="{Binding FilterThemeCommand}" CommandParameter="Большие" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Большие">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Избранные" Command="{Binding FilterThemeCommand}" CommandParameter="Избранные" Margin="6,0,0,0" Padding="11,5">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DisplayFilter}" Value="Избранные">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Style="{DynamicResource Reference.Metric}" Margin="0,0,6,0">
        <DockPanel>
          <Border Style="{DynamicResource Reference.MetricIcon}">
            <icons:PackIconLucide Kind="Layers" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayCount}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Всего паков" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Reference.Metric}" Grid.Column="1" Margin="6,0">
        <DockPanel>
          <Border Style="{DynamicResource Reference.MetricIcon}">
            <icons:PackIconLucide Kind="Tag" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding InstalledCount}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Установлено" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Reference.Metric}" Grid.Column="2" Margin="6,0">
        <DockPanel>
          <Border Style="{DynamicResource Reference.MetricIcon}">
            <icons:PackIconLucide Kind="HardDrive" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplaySize}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Общий размер" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{DynamicResource Reference.Metric}" Grid.Column="3" Margin="6,0,0,0">
        <DockPanel>
          <Border Style="{DynamicResource Reference.MetricIcon}">
            <icons:PackIconLucide Kind="Network" Foreground="{DynamicResource Brush.Accent}" Width="23" Height="23" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding EntityCount}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Поддерживаемых сущностей" Style="{DynamicResource Text.Metadata}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Style="{DynamicResource Panel.Card}" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}" Padding="16,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <icons:PackIconLucide Kind="List" Style="{DynamicResource Reference.Icon}" />
              <TextBlock Text="Доступные data-seed паки" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource Reference.PreviewAction}" Background="{DynamicResource Brush.DropzoneBackground}" BorderBrush="{DynamicResource Brush.DropzoneBorder}" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <icons:PackIconLucide Kind="CloudUpload" Margin="0,0,12,0" Width="28" Height="28" />
                <TextBlock Text="Перетащите .seedpack или .json сюда&#xA;или нажмите для выбора файла" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" Margin="12,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ExampleNotice}" Style="{DynamicResource Text.Optional}" FontSize="10" Margin="16,2" />
        <TextBlock DockPanel.Dock="Bottom" Text="Чтение библиотеки…" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" Margin="12,4" />
        <DataGrid ItemsSource="{Binding DisplayItems}" SelectedItem="{Binding SelectedDisplayPack}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="SeedPackRows" FontSize="12">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40">
              <DataGridTemplateColumn.Header>
                <CheckBox IsChecked="False" IsHitTestVisible="False" />
              </DataGridTemplateColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=OneWay}" IsHitTestVisible="False" HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Название пака" Width="2.3*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:PackIconLucide Kind="{Binding Icon}" Width="18" Height="18" Foreground="{DynamicResource Brush.AccentText}" Margin="4,0,14,0" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding Title}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Тема" Width="0.95*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Reference.Badge}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Theme}" Value="Fantasy">
                            <Setter Property="Background" Value="{DynamicResource Brush.PurpleBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PurpleForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Theme}" Value="Sci-Fi">
                            <Setter Property="Background" Value="{DynamicResource Brush.ErrorBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.ErrorForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Theme}" Value="Generic">
                            <Setter Property="Background" Value="{DynamicResource Brush.NeutralBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.NeutralForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Theme}" FontSize="11" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Размер" Width="0.85*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Reference.Badge}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Size}" Value="Large">
                            <Setter Property="Background" Value="{DynamicResource Brush.WarningBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.WarningForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Size}" Value="XL">
                            <Setter Property="Background" Value="{DynamicResource Brush.PurpleBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.PurpleForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Size}" Value="Small">
                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Size}" FontSize="11" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Сущности (польз. / события / чаты / доки)" Binding="{Binding Entities}" Width="2.35*" />
            <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="0.75*" />
            <DataGridTemplateColumn Header="Статус" Width="1.25*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Reference.Badge}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Installed}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.SuccessForeground}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="Черновик">
                            <Setter Property="Background" Value="{DynamicResource Brush.NeutralBackground}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.NeutralForeground}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock FontSize="10">
                      <Run Text="● " />
                      <Run Text="{Binding Status}" />
                    </TextBlock>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Действия" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}" ToolTip="Просмотр">
                      <icons:PackIconLucide Kind="Eye" />
                    </Button>
                    <Button Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}" ToolTip="Копировать пак">
                      <icons:PackIconLucide Kind="Copy" />
                    </Button>
                    <Button Style="{DynamicResource Button.Icon}" Command="{x:Static components:PlaceholderActions.Explain}" ToolTip="Ещё">
                      <icons:PackIconLucide Kind="Ellipsis" />
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Row="3" Style="{DynamicResource Panel.Card}" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Reference.Heading}">
          <StackPanel Orientation="Horizontal">
            <icons:PackIconLucide Kind="NotebookText" Style="{DynamicResource Reference.Icon}" />
            <TextBlock Text="Структура и содержимое пака" Style="{DynamicResource Text.GroupTitle}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <TabControl>
          <TabItem Header="Сущности">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid Margin="12,6,12,8" MinHeight="190">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.6*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,10,0">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,2">
                    <icons:PackIconLucide Kind="NotebookText" Style="{DynamicResource Reference.Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="Включённые сущности" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                  <UniformGrid Columns="3" Rows="2">
                    <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                      <DockPanel>
                        <icons:PackIconLucide Kind="UserRound" Style="{DynamicResource Reference.Icon}" VerticalAlignment="Top" Margin="0,3,12,0" />
                        <StackPanel>
                          <TextBlock Text="Пользователи" FontSize="11" />
                          <TextBlock Text="{Binding SelectedDisplayPack.Users, TargetNullValue=—}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Сотрудники с отделами&#xA;и ролями" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                      <DockPanel>
                        <icons:PackIconLucide Kind="CalendarDays" Style="{DynamicResource Reference.Icon}" VerticalAlignment="Top" Margin="0,3,12,0" />
                        <StackPanel>
                          <TextBlock Text="Календарные события" FontSize="11" />
                          <TextBlock Text="{Binding SelectedDisplayPack.Events, TargetNullValue=—}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Встречи, созвоны,&#xA;мероприятия" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                      <DockPanel>
                        <icons:PackIconLucide Kind="MessageCircle" Style="{DynamicResource Reference.Icon}" VerticalAlignment="Top" Margin="0,3,12,0" />
                        <StackPanel>
                          <TextBlock Text="Чаты" FontSize="11" />
                          <TextBlock Text="{Binding SelectedDisplayPack.Chats, TargetNullValue=—}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Каналы и сообщения" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                      <DockPanel>
                        <icons:PackIconLucide Kind="FileText" Style="{DynamicResource Reference.Icon}" VerticalAlignment="Top" Margin="0,3,12,0" />
                        <StackPanel>
                          <TextBlock Text="Документы" FontSize="11" />
                          <TextBlock Text="{Binding SelectedDisplayPack.Documents, TargetNullValue=—}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Файлы разных типов" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                      <DockPanel>
                        <icons:PackIconLucide Kind="Network" Style="{DynamicResource Reference.Icon}" VerticalAlignment="Top" Margin="0,3,12,0" />
                        <StackPanel>
                          <TextBlock Text="Отделы" FontSize="11" />
                          <TextBlock Text="{Binding SelectedDisplayPack.Departments, TargetNullValue=—}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Организационная структура" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border Style="{DynamicResource Panel.Card}" Padding="12,10" Margin="3,4">
                      <DockPanel>
                        <icons:PackIconLucide Kind="Layers" Style="{DynamicResource Reference.Icon}" VerticalAlignment="Top" Margin="0,3,12,0" />
                        <StackPanel>
                          <TextBlock Text="Наборы данных" FontSize="11" />
                          <TextBlock Text="{Binding SelectedDisplayPack.Departments, TargetNullValue=—}" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Справочники и настройки" Style="{DynamicResource Text.Metadata}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </UniformGrid>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <icons:PackIconLucide Kind="Settings" Style="{DynamicResource Reference.Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                    <TextBlock Text="Параметры генерации" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                  <StackPanel>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Локаль имен" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Русские (RU)" FontSize="10" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Стиль данных" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Реалистичные, деловые" FontSize="10" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Рабочее время" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Пн–Пт, 09:00 – 18:00" FontSize="10" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Плотность встреч" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Средняя (2–5 в день)" FontSize="10" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Шаблоны отделов" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="IT, HR, Sales, Marketing" FontSize="10" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Шаблоны документов" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Отчёты, Презентации, Политики" FontSize="10" />
                      </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Вложения" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1" Text="Документы и изображения" FontSize="10" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Grid>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Поля">
            <DataGrid ItemsSource="{Binding SelectedPack.Manifest.Sections}" AutoGenerateColumns="False" IsReadOnly="True" Margin="12">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Секция" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Записей" Binding="{Binding RecordCount}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Правила генерации">
            <TextBlock Text="Правила генерации будут доступны после подключения редактора паков." TextWrapping="Wrap" Margin="16" />
          </TabItem>
          <TabItem Header="Валидация">
            <TextBlock Text="{Binding WorkflowReason}" TextWrapping="Wrap" Margin="16" />
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>