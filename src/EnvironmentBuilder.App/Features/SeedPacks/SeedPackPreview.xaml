<UserControl x:Class="EnvironmentBuilder.App.Features.SeedPacks.SeedPackPreview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Title" AutomationProperties.Name="Секция preview" />
      <components:SpacedWrapPanel Margin="0,4,0,0">
        <Button Content="Сначала" ToolTip="Первая страница" AutomationProperties.Name="Первая страница" FontSize="{DynamicResource FontSize.Small}" Padding="8,4" Command="{Binding FirstCommand}" AutomationProperties.AutomationId="SeedPreviewFirst" />
        <Button Content="Далее →" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница" FontSize="{DynamicResource FontSize.Small}" Padding="8,4" Command="{Binding NextCommand}" AutomationProperties.AutomationId="SeedPreviewNext" />
        <Button Content="Отмена" FontSize="{DynamicResource FontSize.Small}" Padding="8,4" Command="{Binding CancelCommand}" />
      </components:SpacedWrapPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Style="{DynamicResource Text.Metadata}" FontSize="{DynamicResource FontSize.Small}" Margin="0,4,0,0" AutomationProperties.AutomationId="SeedPreviewStatus" />
    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Metadata}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SeedPreviewText" />
  </DockPanel>
</UserControl>
