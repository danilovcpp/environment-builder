<Window x:Class="EnvironmentBuilder.App.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" xmlns:authoring="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:packs="clr-namespace:EnvironmentBuilder.App.Features.SeedPacks" xmlns:settings="clr-namespace:EnvironmentBuilder.App.Features.Settings" xmlns:diagnostics="clr-namespace:EnvironmentBuilder.App.Features.Diagnostics" Title="Environment Builder" Icon="/EnvironmentBuilder.App;component/Assets/AppIcon.ico" Width="1280" Height="800" MinWidth="960" MinHeight="600" SizeChanged="WindowSizeChanged" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.TextPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <DataTemplate DataType="{x:Type authoring:EnvironmentListViewModel}">
            <authoring:EnvironmentListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authoring:EnvironmentEditorViewModel}">
            <authoring:EnvironmentEditorPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authoring:ComposePreviewViewModel}">
            <authoring:ComposePreviewPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authoring:InspectViewModel}">
            <authoring:InspectPage />
        </DataTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource Brush.Canvas}">
        <Grid Background="{DynamicResource Brush.Canvas}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Grid.Sidebar}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10,18,8,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,22">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource AppIcon}" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="EOffice Dev Tools" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.Brand}" />
                                <TextBlock Text="Local Environment Manager" Style="{DynamicResource Text.Metadata}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Button Command="{Binding NavigateCommand}" CommandParameter="settings" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowSettings}" AutomationProperties.Name="Настройки" AutomationProperties.AutomationId="NavigateSettings">
                            <StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Settings" Margin="0,0,12,0" /><TextBlock Text="Настройки" Style="{DynamicResource Text.ControlLabel}" /></StackPanel>
                        </Button>
                        <TextBlock Text="Локальный режим" Style="{DynamicResource Text.Metadata}" Margin="12,10,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="environments" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowEnvironments}" AutomationProperties.Name="Окружения" AutomationProperties.AutomationId="NavigateEnvironments">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Layers" Margin="0,0,12,0" />
                                <TextBlock Text="Окружения" Style="{DynamicResource Text.ControlLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="seedpacks" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowSeedPacks}" AutomationProperties.Name="Тестовые данные">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Database" Margin="0,0,12,0" />
                                <TextBlock Text="Тестовые данные" Style="{DynamicResource Text.ControlLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="services" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowServices}" AutomationProperties.Name="Сервисы" AutomationProperties.AutomationId="NavigateServices">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Boxes" Margin="0,0,12,0" />
                                <TextBlock Text="Сервисы" Style="{DynamicResource Text.ControlLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="diagnostics" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowDiagnostics}" AutomationProperties.Name="Диагностика">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Activity" Margin="0,0,12,0" />
                                <TextBlock Text="Диагностика" Style="{DynamicResource Text.ControlLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <components:PageHeader Grid.Column="1" Grid.ColumnSpan="2" Title="{Binding Title}" Description="{Binding Description}" Icon="{Binding PageIcon}" IsCompact="{DynamicResource Layout.Compact}">
                <components:PageHeader.Actions>
                    <Grid>
                        <ContentControl Tag="HeaderActions" Content="{Binding Authoring.Current}" Visibility="{Binding ShowEnvironments, Converter={StaticResource VisibleIfTrue}}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type authoring:EnvironmentListViewModel}">
                                    <components:SpacedWrapPanel>
                                        <Button Command="{Binding CreateNewCommand}" Style="{DynamicResource Button.Primary}" AutomationProperties.AutomationId="CreateEnvironment">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconLucide Kind="Plus" Margin="{DynamicResource Margin.Related}" />
                                                <TextBlock Text="Создать окружение" Style="{DynamicResource Text.ControlLabel}" />
                                            </StackPanel>
                                        </Button>
                                        <Button IsEnabled="False" ToolTip="В разработке: импорт описания окружения из файла" ToolTipService.ShowOnDisabled="True" Style="{DynamicResource Button.Secondary}">
                                            <StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="FileInput" Margin="{DynamicResource Margin.Related}" /><TextBlock Text="Импорт" /></StackPanel>
                                        </Button>
                                        <Button IsEnabled="False" ToolTip="В разработке: экспорт описания окружения в файл" ToolTipService.ShowOnDisabled="True" Style="{DynamicResource Button.Secondary}">
                                            <StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Upload" Margin="{DynamicResource Margin.Related}" /><TextBlock Text="Экспорт" /></StackPanel>
                                        </Button>
                                    </components:SpacedWrapPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type authoring:EnvironmentEditorViewModel}">
                                    <components:SpacedWrapPanel>
                                        <Button Content="К списку" Command="{Binding GoBackCommand}" AutomationProperties.AutomationId="BackToList" />
                                        <Button Content="Compose preview" Command="{Binding ShowPreviewCommand}" AutomationProperties.AutomationId="ShowCompose" />
                                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{DynamicResource Button.Primary}" AutomationProperties.AutomationId="SaveEnvironment" />
                                    </components:SpacedWrapPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type authoring:ComposePreviewViewModel}">
                                    <components:SpacedWrapPanel>
                                        <Button Content="Назад" Command="{Binding GoBackCommand}" AutomationProperties.AutomationId="BackFromPreview" />
                                        <Button Content="Копировать preview" Command="{Binding CopyCommand}" />
                                    </components:SpacedWrapPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type authoring:InspectViewModel}">
                                    <components:SpacedWrapPanel>
                                        <Button Content="Назад" Command="{Binding ReturnCommand}" AutomationProperties.AutomationId="InspectBack" />
                                        <Button Content="Compose" Command="{Binding ShowComposeCommand}" AutomationProperties.AutomationId="InspectCompose" />
                                        <Button Content="Запустить" Command="{Binding StartCommand}" ToolTip="{Binding StartDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="StartEnvironment" />
                                        <Button Content="Остановить" Command="{Binding StopCommand}" ToolTip="{Binding StopDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="StopEnvironment" Style="{DynamicResource Button.Primary}" />
                                    </components:SpacedWrapPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                        <components:SpacedWrapPanel Visibility="{Binding ShowSeedPacks, Converter={StaticResource VisibleIfTrue}}">
                            <Button Command="{Binding SeedPacks.ImportCommand}" Style="{DynamicResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Upload" Margin="{DynamicResource Margin.Related}" />
                                    <TextBlock Text="Загрузить пак" Style="{DynamicResource Text.ControlLabel}" />
                                </StackPanel>
                            </Button>
                            <Button IsEnabled="False" ToolTip="В разработке: создание пакета в приложении. Сейчас можно импортировать внешний ZIP." ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Plus" Margin="{DynamicResource Margin.Related}" /><TextBlock Text="Создать пак" /></StackPanel>
                            </Button>
                            <Button Command="{Binding SeedPacks.RemoveCommand}" Style="{DynamicResource Button.Destructive}" ToolTip="Удалить выбранный пакет из библиотеки" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Trash2" Margin="{DynamicResource Margin.Related}" />
                                    <TextBlock Text="Удалить" Style="{DynamicResource Text.ControlLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SeedPacks.ApplyToEnvironmentCommand}" Style="{DynamicResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Play" Margin="{DynamicResource Margin.Related}" />
                                    <TextBlock Text="Применить к окружению" Style="{DynamicResource Text.ControlLabel}" />
                                </StackPanel>
                            </Button>
                        </components:SpacedWrapPanel>
                        <components:SpacedWrapPanel Visibility="{Binding ShowServices, Converter={StaticResource VisibleIfTrue}}">
                            <Button Command="{Binding Settings.SaveCommand}" Style="{DynamicResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Save" Margin="{DynamicResource Margin.Related}" />
                                    <TextBlock Text="Сохранить библиотеку" Style="{DynamicResource Text.ControlLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Settings.ResetCommand}" Style="{DynamicResource Button.Secondary}" ToolTip="Перечитать сохранённую библиотеку и отменить изменения">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="RotateCcw" Margin="{DynamicResource Margin.Related}" />
                                    <TextBlock Text="Отменить изменения" Style="{DynamicResource Text.ControlLabel}" />
                                </StackPanel>
                            </Button>
                        </components:SpacedWrapPanel>
                    </Grid>
                </components:PageHeader.Actions>
            </components:PageHeader>
            <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Canvas}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContext}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <DockPanel Margin="18,12,16,6">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StorageError}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" />
                    <TextBlock DockPanel.Dock="Top" Text="Чтение локального хранилища…" Visibility="{Binding IsLoading, Converter={StaticResource VisibleIfTrue}}" />
                    <Grid>
                        <ContentControl x:Name="EnvironmentContent" Content="{Binding Authoring.Current}" Visibility="{Binding ShowEnvironments, Converter={StaticResource VisibleIfTrue}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        <packs:SeedPackLibraryPage DataContext="{Binding SeedPacks}" Visibility="{Binding DataContext.ShowSeedPacks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                        <settings:SettingsPage DataContext="{Binding Settings}" Visibility="{Binding DataContext.ShowServices, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                        <settings:ApplicationSettingsPage DataContext="{Binding ApplicationSettings}" Visibility="{Binding DataContext.ShowSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                        <diagnostics:DiagnosticsPage DataContext="{Binding Diagnostics}" Visibility="{Binding DataContext.ShowDiagnostics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                    </Grid>
                </DockPanel>
            </Grid>
            <components:ContextPanel x:Name="PageContext" Grid.Row="1" Grid.Column="2" Heading="{Binding ContextTitle}" Text="{Binding ContextSummary}" SupportingText="{Binding ContextSupportingText}" Detail="{Binding ContextDetail}" Visibility="{Binding HasContext, Converter={StaticResource VisibleIfTrue}}" />
            <components:StatusBar Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}" />
        </Grid>
    </Border>
</Window>
