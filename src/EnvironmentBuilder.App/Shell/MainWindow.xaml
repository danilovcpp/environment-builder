<Window x:Class="EnvironmentBuilder.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:components="clr-namespace:EnvironmentBuilder.App.Components"
        xmlns:authoring="clr-namespace:EnvironmentBuilder.App.Features.Environments"
        Title="Environment Builder" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <DataTemplate DataType="{x:Type authoring:EnvironmentListViewModel}"><authoring:EnvironmentListPage/></DataTemplate>
        <DataTemplate DataType="{x:Type authoring:EnvironmentEditorViewModel}"><authoring:EnvironmentEditorPage/></DataTemplate>
        <DataTemplate DataType="{x:Type authoring:ComposePreviewViewModel}"><authoring:ComposePreviewPage/></DataTemplate>
        <DataTemplate DataType="{x:Type authoring:InspectViewModel}"><authoring:InspectPage/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Brush.Sidebar}" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Environment Builder" FontWeight="SemiBold" Margin="0,0,0,24" />
                <Button DockPanel.Dock="Bottom" Command="{Binding ToggleThemeCommand}" Content="Сменить тему" AutomationProperties.Name="Переключить светлую и тёмную тему" />
                <StackPanel>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="environments" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowEnvironments}" Margin="0,0,0,8" AutomationProperties.Name="Окружения"><StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Box" Margin="0,0,8,0" /><TextBlock Text="Окружения" /></StackPanel></Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="seedpacks" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowSeedPacks}" Margin="0,0,0,8" AutomationProperties.Name="Тестовые данные"><StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Database" Margin="0,0,8,0" /><TextBlock Text="Тестовые данные" /></StackPanel></Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="settings" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowSettings}" Margin="0,0,0,8" AutomationProperties.Name="Настройки"><StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Settings" Margin="0,0,8,0" /><TextBlock Text="Настройки" /></StackPanel></Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="diagnostics" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowDiagnostics}" AutomationProperties.Name="Диагностика"><StackPanel Orientation="Horizontal"><icons:PackIconLucide Kind="Activity" Margin="0,0,8,0" /><TextBlock Text="Диагностика" /></StackPanel></Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Background="{DynamicResource Brush.Canvas}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <components:PageHeader Title="{Binding Title}" Description="{Binding Description}" />
            <TextBlock Grid.Row="1" Text="{Binding StorageError}" Foreground="{DynamicResource Brush.ErrorForeground}" Margin="24,8" TextWrapping="Wrap" />
            <Grid Grid.Row="2" Margin="24,8,24,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource VisibleIfTrue}}"><TextBlock Text="Чтение локального хранилища…" /></StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding Authoring.Current}" Visibility="{Binding ShowEnvironments, Converter={StaticResource VisibleIfTrue}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <TextBlock Grid.Row="1" Visibility="{Binding ShowSeedPacks, Converter={StaticResource VisibleIfTrue}}" Text="Пакеты начальных данных" Foreground="{DynamicResource Brush.TextSecondary}" />
                <StackPanel Grid.Row="1" Visibility="{Binding ShowSettings, Converter={StaticResource VisibleIfTrue}}"><TextBlock Text="Каталог данных" FontWeight="SemiBold" /><TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Margin="0,8,0,16" /><Button Command="{Binding ToggleThemeCommand}" Content="Сменить тему" HorizontalAlignment="Left" /></StackPanel>
                <StackPanel Grid.Row="1" Visibility="{Binding ShowDiagnostics, Converter={StaticResource VisibleIfTrue}}"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" /><TextBlock Text="{Binding RecoveryStatus}" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel>
            </Grid>
        </Grid>
        <components:ContextPanel Grid.Column="2" Text="{Binding RecoveryStatus}" />
        <components:StatusBar Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" />
    </Grid>
</Window>
