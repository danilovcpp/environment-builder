<Window x:Class="EnvironmentBuilder.App.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components" xmlns:authoring="clr-namespace:EnvironmentBuilder.App.Features.Environments" xmlns:packs="clr-namespace:EnvironmentBuilder.App.Features.SeedPacks" xmlns:settings="clr-namespace:EnvironmentBuilder.App.Features.Settings" xmlns:diagnostics="clr-namespace:EnvironmentBuilder.App.Features.Diagnostics" xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Environment Builder" Width="1280" Height="800" MinWidth="960" MinHeight="600" SizeChanged="WindowSizeChanged" WindowStyle="None" Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.TextPrimary}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="18" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" />
    </chrome:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        <DataTemplate DataType="{x:Type authoring:EnvironmentListViewModel}">
            <authoring:EnvironmentListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authoring:EnvironmentEditorViewModel}">
            <authoring:EnvironmentEditorPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authoring:ComposePreviewViewModel}">
            <authoring:ComposePreviewPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authoring:InspectViewModel}">
            <authoring:InspectPage />
        </DataTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8">
        <Grid Background="{DynamicResource Brush.Canvas}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Grid.Sidebar}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.RowSpan="2" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10,18,8,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,22">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource Brush.Accent}" Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0">
                                <icons:PackIconLucide Kind="Package" Width="24" Height="24" Foreground="White" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="EOffice Dev Tools" FontWeight="SemiBold" FontSize="17" />
                                <TextBlock Text="Local Environment Manager" Style="{DynamicResource Text.Metadata}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,16,10,0">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="#2EAE25" Margin="0,0,14,0" />
                            <Button Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="Переключить светлую и тёмную тему" Style="{DynamicResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="0" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="Локальный режим" FontSize="12" />
                                    <TextBlock Text="v1.2.0" Style="{DynamicResource Text.Metadata}" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Button>
                            <icons:PackIconLucide Kind="ChevronRight" Width="14" Height="14" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="environments" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowEnvironments}" AutomationProperties.Name="Окружения">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Layers" Margin="0,0,12,0" />
                                <TextBlock Text="Окружения" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="seedpacks" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowSeedPacks}" AutomationProperties.Name="Тестовые данные">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Database" Margin="0,0,12,0" />
                                <TextBlock Text="Тестовые данные" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenComposeCommand}" Style="{DynamicResource Button.Navigation}" AutomationProperties.Name="Compose preview">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Box" Margin="0,0,12,0" />
                                <TextBlock Text="Compose preview" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="settings" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowSettings}" AutomationProperties.Name="Настройки">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Settings" Margin="0,0,12,0" />
                                <TextBlock Text="Настройки" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="diagnostics" Style="{DynamicResource Button.Navigation}" Selector.IsSelected="{Binding ShowDiagnostics}" AutomationProperties.Name="Диагностика">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Activity" Margin="0,0,12,0" />
                                <TextBlock Text="Диагностика" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <components:PageHeader Grid.Column="1" Grid.ColumnSpan="2" Title="{Binding Title}" Description="{Binding Description}" Icon="{Binding PageIcon}">
                <components:PageHeader.Actions>
                    <Grid>
                        <ContentControl Tag="HeaderActions" Content="{Binding Authoring.Current}" Visibility="{Binding ShowEnvironments, Converter={StaticResource VisibleIfTrue}}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type authoring:EnvironmentListViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconLucide Kind="FileInput" Margin="0,0,8,0" />
                                                <TextBlock Text="Импорт" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconLucide Kind="Upload" Margin="0,0,8,0" />
                                                <TextBlock Text="Экспорт" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CreateNewCommand}" Style="{DynamicResource Button.Primary}" AutomationProperties.AutomationId="CreateEnvironment">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconLucide Kind="Plus" Margin="0,0,8,0" />
                                                <TextBlock Text="Создать окружение" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type authoring:EnvironmentEditorViewModel}">
                                    <WrapPanel>
                                        <Button Content="К списку" Command="{Binding GoBackCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="BackToList" />
                                        <Button Content="Compose preview" Command="{Binding ShowPreviewCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ShowCompose" />
                                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{DynamicResource Button.Primary}" AutomationProperties.AutomationId="SaveEnvironment" />
                                    </WrapPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type authoring:ComposePreviewViewModel}">
                                    <WrapPanel>
                                        <Button Content="Назад" Command="{Binding GoBackCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="BackFromPreview" />
                                        <Button Content="Копировать preview" Command="{Binding CopyCommand}" />
                                    </WrapPanel>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type authoring:InspectViewModel}">
                                    <WrapPanel>
                                        <Button Content="Назад" Command="{Binding ReturnCommand}" AutomationProperties.AutomationId="InspectBack" Margin="0,0,8,0" />
                                        <Button Content="Compose" Command="{Binding ShowComposeCommand}" AutomationProperties.AutomationId="InspectCompose" Margin="0,0,8,0" />
                                        <Button Content="Запустить" Command="{Binding StartCommand}" ToolTip="{Binding StartDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="StartEnvironment" Margin="0,0,8,0" />
                                        <Button Content="Остановить" Command="{Binding StopCommand}" ToolTip="{Binding StopDisabledReason}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="StopEnvironment" Style="{DynamicResource Button.Primary}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                        <WrapPanel Visibility="{Binding ShowSeedPacks, Converter={StaticResource VisibleIfTrue}}">
                            <Button Command="{x:Static components:PlaceholderActions.Explain}" Style="{DynamicResource Button.Primary}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Upload" Margin="0,0,8,0" />
                                    <TextBlock Text="Загрузить пак" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Plus" Margin="0,0,8,0" />
                                    <TextBlock Text="Создать пак" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Trash2" Margin="0,0,8,0" />
                                    <TextBlock Text="Удалить" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Static components:PlaceholderActions.Explain}" Style="{DynamicResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Play" Margin="0,0,8,0" />
                                    <TextBlock Text="Применить к окружению" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <WrapPanel Visibility="{Binding ShowSettings, Converter={StaticResource VisibleIfTrue}}">
                            <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="RotateCcw" Margin="0,0,8,0" />
                                    <TextBlock Text="Сбросить" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource Reference.PreviewAction}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Save" Margin="0,0,8,0" />
                                    <TextBlock Text="Сохранить настройки" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Static components:PlaceholderActions.Explain}" Style="{DynamicResource Button.Primary}">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Play" Margin="0,0,8,0" />
                                    <TextBlock Text="Применить" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </components:PageHeader.Actions>
            </components:PageHeader>
            <Grid Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.Canvas}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContext}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <DockPanel Margin="18,12,16,6">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StorageError}" Style="{DynamicResource Text.Optional}" Foreground="{DynamicResource Brush.ErrorForeground}" />
                    <TextBlock DockPanel.Dock="Top" Text="Чтение локального хранилища…" Visibility="{Binding IsLoading, Converter={StaticResource VisibleIfTrue}}" />
                    <Grid>
                        <ContentControl x:Name="EnvironmentContent" Content="{Binding Authoring.Current}" Visibility="{Binding ShowEnvironments, Converter={StaticResource VisibleIfTrue}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        <packs:SeedPackLibraryPage DataContext="{Binding SeedPacks}" Visibility="{Binding DataContext.ShowSeedPacks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                        <settings:SettingsPage DataContext="{Binding Settings}" Visibility="{Binding DataContext.ShowSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                        <diagnostics:DiagnosticsPage DataContext="{Binding Diagnostics}" Visibility="{Binding DataContext.ShowDiagnostics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIfTrue}}" />
                    </Grid>
                </DockPanel>
            </Grid>
            <components:ContextPanel Grid.Row="1" Grid.Column="2" Heading="{Binding ContextTitle}" Text="{Binding ContextSummary}" SupportingText="{Binding ContextSupportingText}" Detail="{Binding ContextDetail}" Visibility="{Binding HasContext, Converter={StaticResource VisibleIfTrue}}" />
            <components:StatusBar Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Status}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Click="MinimizeWindow" Style="{DynamicResource Button.Ghost}" Width="34" Height="18" MinHeight="18" Padding="9,3" AutomationProperties.Name="Свернуть">
                    <icons:PackIconLucide Kind="Minus" Width="12" Height="12" />
                </Button>
                <Button Click="MaximizeWindow" Style="{DynamicResource Button.Ghost}" Width="34" Height="18" MinHeight="18" Padding="9,3" AutomationProperties.Name="Развернуть">
                    <icons:PackIconLucide Kind="Square" Width="10" Height="10" />
                </Button>
                <Button Click="CloseWindow" Style="{DynamicResource Button.Ghost}" Width="34" Height="18" MinHeight="18" Padding="9,3" AutomationProperties.Name="Закрыть">
                    <icons:PackIconLucide Kind="X" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
