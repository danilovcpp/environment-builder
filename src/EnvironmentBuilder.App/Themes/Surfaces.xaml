<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <Style x:Key="Panel.Heading" TargetType="Border">
        <Setter Property="Padding" Value="{DynamicResource Padding.PanelHeader}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.DividerBottom}" />
    </Style>
    <Style x:Key="Icon.Section" TargetType="icons:PackIconLucide">
        <Setter Property="Width" Value="{DynamicResource Icon.Large}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Large}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Margin" Value="{DynamicResource Margin.SectionIcon}" />
    </Style>
    <Style x:Key="Panel.Metric" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
        <Setter Property="Padding" Value="{DynamicResource Padding.Metric}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Metric}" />
    </Style>
    <Style x:Key="Icon.Metric" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource Size.MetricIcon}" />
        <Setter Property="Height" Value="{DynamicResource Size.MetricIcon}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Circle}" />
        <Setter Property="Background" Value="{DynamicResource Brush.InfoBackground}" />
        <Setter Property="Margin" Value="{DynamicResource Margin.MetricIcon}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge.Neutral}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.ChoiceControl}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.BadgeDense}" />
        <Setter Property="Background" Value="{DynamicResource Brush.InfoBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoForeground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource Margin.SearchContent}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Metadata}" />
    </Style>
    <Style x:Key="Text.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{DynamicResource Margin.SearchContent}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Small}" />
    </Style>
    <Style x:Key="Button.OutlineIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
    </Style>
    <Style x:Key="Button.Placeholder" TargetType="Button" BasedOn="{StaticResource Button.Accent}">
        <Setter Property="ToolTip" Value="Демонстрация интерфейса: действие пока недоступно." />
        <Setter Property="Command" Value="{x:Static components:PlaceholderActions.Explain}" />
    </Style>
</ResourceDictionary>
