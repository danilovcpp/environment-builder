<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="Font.Application">Segoe UI Variable, Segoe UI</FontFamily>
    <GridLength x:Key="Grid.Sidebar">248</GridLength>
    <sys:Double x:Key="FontSize.PageTitle">24</sys:Double>
    <sys:Double x:Key="FontSize.SectionTitle">16</sys:Double>
    <sys:Double x:Key="FontSize.GroupTitle">14</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Metadata">12</sys:Double>
    <sys:Double x:Key="FontSize.Kpi">20</sys:Double>
    <sys:Double x:Key="FontSize.Badge">12</sys:Double>
    <Style x:Key="Text.Default" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Application}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Implicit text inherits foreground from its control, including primary/disabled states. -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Default}" />
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Default}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.SectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.GroupTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Metadata" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Metadata}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.CanvasSupporting" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.CanvasSupportingText}" />
    </Style>
    <Style x:Key="Text.Kpi" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Kpi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Optional" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Text.Badge" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Badge}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
</ResourceDictionary>
