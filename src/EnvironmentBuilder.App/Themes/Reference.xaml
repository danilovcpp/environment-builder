<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <Style x:Key="Reference.Heading" TargetType="Border">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="Reference.Icon" TargetType="icons:PackIconLucide">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="Reference.Metric" TargetType="Border" BasedOn="{StaticResource Panel.Card}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="78" />
    </Style>
    <Style x:Key="Reference.MetricIcon" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="{DynamicResource Brush.InfoBackground}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Reference.Badge" TargetType="Border" BasedOn="{StaticResource Badge.Neutral}">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Background" Value="{DynamicResource Brush.InfoBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.InfoForeground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Reference.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Reference.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Metadata}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="Reference.OutlineIcon" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style x:Key="Reference.Switch" TargetType="CheckBox" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel>
                        <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="{DynamicResource Brush.BorderStrong}" Margin="0,0,12,0">
                            <Ellipse x:Name="Knob" Fill="White" Width="12" Height="12" HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Reference.PreviewAction" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="ToolTip" Value="Демонстрация интерфейса: действие пока недоступно." />
        <Setter Property="Command" Value="{x:Static components:PlaceholderActions.Explain}" />
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Control.Base}">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <DockPanel>
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <Ellipse Stroke="{DynamicResource Brush.IconMuted}" Fill="{DynamicResource Brush.Input}" StrokeThickness="1" />
                            <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Reference.ExpanderToggle" TargetType="ToggleButton" BasedOn="{StaticResource Control.Base}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource Brush.IconMuted}" StrokeThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Expander" BasedOn="{StaticResource Control.Base}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{StaticResource Reference.ExpanderToggle}" />
                        <ContentPresenter x:Name="ExpandedBody" ContentSource="Content" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandedBody" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
