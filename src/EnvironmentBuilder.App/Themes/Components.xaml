        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{DynamicResource Thickness.Border}" CornerRadius="{DynamicResource Radius.Button}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
