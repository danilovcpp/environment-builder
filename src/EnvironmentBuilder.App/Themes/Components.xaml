    <Style x:Key="Toggle.Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="{DynamicResource Size.Switch}" Height="{DynamicResource Size.Checkbox}" VerticalAlignment="Center" CornerRadius="{DynamicResource Radius.Switch}" Background="{DynamicResource Brush.BorderStrong}">
                            <Ellipse x:Name="Knob" Fill="{DynamicResource Brush.OnAccent}" Width="{DynamicResource Size.SwitchKnob}" Height="{DynamicResource Size.SwitchKnob}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.SwitchKnob}" />
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{DynamicResource Margin.ChoiceLabel}" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.IconMuted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Border}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Control.Outlined}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.ChoiceControl}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="{DynamicResource Size.Checkbox}" Height="{DynamicResource Size.Checkbox}" VerticalAlignment="Center">
                            <Ellipse x:Name="RadioOutline" Stroke="{TemplateBinding BorderBrush}" Fill="{TemplateBinding Background}" StrokeThickness="{DynamicResource Icon.StrokeThin}" />
                            <Ellipse x:Name="RadioDot" Width="{DynamicResource Icon.Chevron}" Height="{DynamicResource Icon.Chevron}" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{DynamicResource Margin.ChoiceLabel}" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RadioOutline" Property="Stroke" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RadioOutline" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RadioOutline" Property="Stroke" Value="{DynamicResource Brush.Border}" />
                            <Setter TargetName="RadioOutline" Property="Fill" Value="{DynamicResource Brush.PanelMuted}" />
                            <Setter TargetName="RadioDot" Property="Fill" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Expander.Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Control.Base}">
