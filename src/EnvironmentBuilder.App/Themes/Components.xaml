<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:components="clr-namespace:EnvironmentBuilder.App.Components">
    <components:RoundedClipConverter x:Key="RoundedClip" />
    <components:SelectionEqualsConverter x:Key="SelectionEquals" />
    <Style TargetType="components:SpacedWrapPanel">
        <Setter Property="Spacing" Value="{DynamicResource Spacing.8}" />
    </Style>
    <!-- A bounded page canvas preserves table virtualization and scrolls on short windows. -->
    <Style x:Key="Layout.PageCanvas" TargetType="FrameworkElement">
        <Setter Property="MinHeight" Value="{DynamicResource Size.PageCanvas}" />
        <Setter Property="Height" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
    </Style>
    <Style TargetType="icons:PackIconLucide">
        <Setter Property="Width" Value="{DynamicResource Icon.Standard}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Standard}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Focus.Keyboard" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="{DynamicResource Margin.FocusRing}" BorderBrush="{DynamicResource Brush.FocusRing}" BorderThickness="{DynamicResource Thickness.Focus}" CornerRadius="{DynamicResource Radius.Button}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Validation.Error">
        <Grid>
            <AdornedElementPlaceholder />
            <Border BorderBrush="{DynamicResource Brush.ErrorForeground}" BorderThickness="{DynamicResource Thickness.Focus}" CornerRadius="{DynamicResource Radius.Input}" IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>
    <Style x:Key="Control.Base" TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Application}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Keyboard}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Validation.Error}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorForeground}" />
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Control.Outlined" TargetType="Control" BasedOn="{StaticResource Control.Base}">
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.Border}" />
    </Style>
    <Style x:Key="Control.Input" TargetType="Control" BasedOn="{StaticResource Control.Outlined}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Focus is painted over the fixed border, so content never moves. -->
    <Style x:Key="Input.FocusRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.Focus}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Input}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding (Validation.HasError), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.ErrorForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Window" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="{DynamicResource Margin.Label}" />
    </Style>
    <Style x:Key="Form.Field" TargetType="HeaderedContentControl" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Margin" Value="{DynamicResource Margin.Field}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <Label Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Target="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="{DynamicResource Margin.ScrollbarVertical}" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Margin="{DynamicResource Margin.ScrollbarHorizontal}" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Brush.ScrollbarTrack}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Control.Outlined}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Button}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Button.Destructive" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ErrorForeground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.ErrorBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.ErrorPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Control.Input}">
        <Style.Triggers>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
        </Style.Triggers>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selected}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Input}">
                            <!-- TextBoxBase supplies Padding to this host itself. -->
                            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource {x:Type ScrollViewer}}" Focusable="False" />
                        </Border>
                        <Border Style="{StaticResource Input.FocusRing}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Input.Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="{DynamicResource Size.Control}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.SearchText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Input}">
                        <DockPanel Margin="{DynamicResource Margin.SearchContent}">
                            <icons:PackIconLucide Kind="Search" DockPanel.Dock="Left" Foreground="{DynamicResource Brush.IconMuted}" Margin="{DynamicResource Margin.Related}" />
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource {x:Type ScrollViewer}}" Focusable="False" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Input.FocusRing}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Control.Base}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.ControlCompact}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource Radius.Small}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.SelectedHover}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Brush.Transparent}">
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="{DynamicResource Icon.Stroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{DynamicResource Margin.Related}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Control.Input}">
        <Setter Property="Padding" Value="{DynamicResource Padding.Select}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Input}" />
                        <ToggleButton Style="{StaticResource ComboBox.Toggle}" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter x:Name="Selection" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" />
                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Margin="{DynamicResource Margin.SelectEditor}" Padding="{DynamicResource Padding.Input}" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}" Visibility="Collapsed" Background="{DynamicResource Brush.Transparent}" Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" SelectionBrush="{DynamicResource Brush.Selected}" SelectionTextBrush="{DynamicResource Brush.TextPrimary}" BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource {x:Type ScrollViewer}}" Focusable="False" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Border Style="{StaticResource Input.FocusRing}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="{DynamicResource Thickness.Border}" CornerRadius="{DynamicResource Radius.Input}" Padding="{DynamicResource Padding.Popup}" Margin="{DynamicResource Margin.Popup}">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource Control.Outlined}">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.ChoiceControl}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="{DynamicResource Size.Checkbox}" Height="{DynamicResource Size.Checkbox}" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Checkbox}">
                            <Grid>
                                <Path x:Name="Check" Data="M 1,4 L 4,7 L 9,1" Width="{DynamicResource Icon.CheckWidth}" Height="{DynamicResource Icon.Chevron}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="{DynamicResource Icon.Stroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <Path x:Name="Indeterminate" Data="M 1,4 L 9,4" Width="{DynamicResource Icon.CheckWidth}" Height="{DynamicResource Icon.Chevron}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Stroke="{DynamicResource Brush.OnAccent}" StrokeThickness="{DynamicResource Icon.Stroke}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="Label" Grid.Column="1" Margin="{DynamicResource Margin.ChoiceLabel}" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Pressed}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsChecked" Value="{x:Null}" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.PanelMuted}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Indeterminate" Property="Stroke" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CheckBox.Table" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CheckBox.TableDisplay" TargetType="CheckBox" BasedOn="{StaticResource CheckBox.Table}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Tab}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Underline" Height="{DynamicResource Spacing.2}" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource Control.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <TabPanel DockPanel.Dock="Top" IsItemsHost="True" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" TextElement.Foreground="{DynamicResource Brush.TextPrimary}" BorderThickness="{DynamicResource Thickness.DividerTop}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Navigation" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.NavigationItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Button}">
                        <Grid>
                            <Border x:Name="Indicator" Width="{DynamicResource Size.NavigationIndicator}" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left" Margin="{DynamicResource Margin.NavigationIndicator}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{DynamicResource Inset.Navigation}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Selector.IsSelected" Value="True">
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="{DynamicResource Margin.ControlBottom}" />
        <Style.Triggers>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                <Setter Property="AutomationProperties.ItemStatus" Value="Выбрано" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
