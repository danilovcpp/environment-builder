<Application x:Class="EnvironmentBuilder.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Components.xaml" />
                <ResourceDictionary Source="Themes/Surfaces.xaml" />
                <ResourceDictionary Source="Assets/AppIcon.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <system:Boolean x:Key="Preference.ShowDescriptions" xmlns:system="clr-namespace:System;assembly=System.Runtime">True</system:Boolean>
        </ResourceDictionary>
    </Application.Resources>
</Application>
