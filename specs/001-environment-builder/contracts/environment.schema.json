{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.environment-builder.local/v1/environment.schema.json",
  "title": "Environment Builder v1 environment",
  "type": "object",
  "properties": {
    "kind": {
      "const": "environment"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "definitionSnapshot": {
            "$ref": "component.schema.json"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/value"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
            }
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/value"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/port"
            }
          },
          "storage": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/storage"
            }
          }
        },
        "required": [
          "id",
          "definitionSnapshot",
          "source",
          "parameters",
          "environment",
          "ports",
          "storage"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependentId": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "requiredId": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "requirementId": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/key"
              },
              {
                "type": "null"
              }
            ]
          },
          "condition": {
            "$ref": "common.schema.json#/$defs/condition"
          },
          "reason": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          }
        },
        "required": [
          "dependentId",
          "requiredId",
          "requirementId",
          "condition",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "baseline": {
      "type": "object",
      "properties": {
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "componentId": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "initializer": {
                "$ref": "initialization.schema.json"
              },
              "seedPack": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "common.schema.json#/$defs/uuid"
                      },
                      "version": {
                        "$ref": "common.schema.json#/$defs/version"
                      },
                      "contentHash": {
                        "$ref": "common.schema.json#/$defs/hash"
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "contentHash"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "componentId",
              "initializer",
              "seedPack"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "applications"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "name",
    "components",
    "dependencies",
    "baseline"
  ],
  "additionalProperties": false
}
